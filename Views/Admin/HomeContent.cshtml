                                <i class="bi @(string.IsNullOrEmpty(currentObjective.IconClass) ? "bi-globe" : currentObjective.IconClass)" id="iconPreview" style="font-size:20px;"></i>
                            </div>
                        </div>
                        <div class="small text-muted mt-1" style="font-size:10.5px;">Click "Pick" to choose from all Bootstrap icons.</div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input name="IsActive" class="form-check-input" type="checkbox" value="true"
                                   @(currentObjective.Id == 0 || currentObjective.IsActive ? "checked" : null)>
                            <label class="form-check-label small">Show on homepage</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/HomeContent" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> @(currentObjective.Id > 0 ? "Update Objective" : "Save Objective")
                </button>
            </div>
        </div>
    </form>
}

<div class="list-card mb-3">
