@model List<Entities.Entities.CommitteeMember>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Executive Committee";
    bool showForm = ViewBag.ShowForm == true;
    var current = ViewBag.CurrentMember as Entities.Entities.CommitteeMember ?? new Entities.Entities.CommitteeMember();
}

@if (TempData["Success"] is string s)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @s
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-head">
    <div class="page-head-left">
        <div class="kicker">Content</div>
        <h1>Executive Committee</h1>
        <p>Manage committee members displayed on the public site.</p>
    </div>
    <div class="page-head-actions">
        <a href="/Admin/Committee?showForm=true" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Member
        </a>
    </div>
</div>

<div class="info-banner">
    <i class="bi bi-info-circle-fill"></i>
    <div>
        <strong>Committee Members</strong>
        <p>Changes made here are reflected on the public <code>/Home/Executive</code> page.</p>
    </div>
</div>

<div class="list-card">
    <div class="list-card-head">
        <div>
            <h2>
                <i class="bi bi-person-badge"></i> All Members
                <span class="count-badge">@(Model?.Count ?? 0)</span>
            </h2>
            <p class="list-card-sub">Select a member to edit their information.</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-people"></i></div>
            <h3>No committee members yet</h3>
            <p>Click "Add Member" to create your first member.</p>
            <a href="/Admin/Committee?showForm=true" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add First Member
            </a>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th style="width:70px;">Photo</th>
                    <th>Full Name</th>
                    <th style="width:220px;">Designation</th>
                    <th class="center" style="width:80px;">Order</th>
                    <th class="center" style="width:100px;">Status</th>
                    <th class="right" style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int n = 0; }
                @foreach (var m in Model.OrderBy(x => x.DisplayOrder))
                {
                    n++;
                    var initials = string.Concat(
                        m.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2).Select(s => s[0])
                    ).ToUpper();
                    <tr>
                        <td class="row-num">@n</td>
                        <td><div class="member-avatar" style="width:36px;height:36px;font-size:12px;">@initials</div></td>
                        <td class="strong">@m.FullName</td>
                        <td>
                            <span style="color:var(--kpgja-gold);font-weight:600;font-size:11.5px;">@m.Designation</span>
                            @if (!string.IsNullOrEmpty(m.Bio))
                            {
                                <div class="desc-cell" style="margin-top:2px;">@m.Bio</div>
                            }
                        </td>
                        <td class="center text-muted">@m.DisplayOrder</td>
                        <td class="center">
                            @if (m.IsActive)
                            {
                                <span class="pill active">Active</span>
                            }
                            else
                            {
                                <span class="pill inactive">Inactive</span>
                            }
                        </td>
                        <td class="right">
                            <div class="row-actions">
                                <a href="/Admin/Committee?showForm=true&id=@m.Id" class="icon-btn edit" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Admin/CommitteeDelete" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="PhotoPath" value="@current.PhotoPath" />
                                    <button type="submit" class="icon-btn delete" title="Delete"
                                            onclick="return confirm('Remove this member?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (showForm)
{
    <form method="post" asp-action="CommitteeSave" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@current.Id" />

        <div class="list-card mt-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2>
                        <i class="bi @(current.Id > 0 ? "bi-pencil-square" : "bi-plus-circle")"></i>
                        @(current.Id > 0 ? "Edit Committee Member" : "Add Committee Member")
                    </h2>
                    <p class="list-card-sub">@(current.Id > 0 ? "Update the member details." : "Enter the member information below.")</p>
                </div>
                <a href="/Admin/Committee" class="btn-cancel">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>

            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input name="FullName" class="form-control" value="@current.FullName"
                               placeholder="e.g.Full Name  " required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Designation <span class="text-danger">*</span></label>
                        <input name="Designation" class="form-control" value="@current.Designation"
                               placeholder="e.g. President, Vice President" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Short Bio</label>
                        <textarea name="Bio" class="form-control" rows="3"
                                  placeholder="Brief biography...">@current.Bio</textarea>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Photo</label>
                        <div class="d-flex gap-3 align-items-center">
                            @if (!string.IsNullOrEmpty(current.PhotoPath))
                            {
                                <img src="@current.PhotoPath" alt="Current photo"
                                     style="width:60px;height:60px;object-fit:cover;border-radius:50%;border:1px solid #ecebe6;">
                            }
                            <input type="file" name="imageFile" class="form-control" accept="image/*">
                        </div>
                        <div class="small text-muted mt-1" style="font-size:10.5px;">Square image recommended (400×400px).</div>
                    </div>
                    <input type="hidden" name="PhotoPath" value="@current.PhotoPath" />
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control"
                               value="@(current.DisplayOrder == 0 ? 1 : current.DisplayOrder)" min="0">
                    </div>
                    <div class="col-md-8 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input name="IsActive" class="form-check-input" type="checkbox" id="activeSwitch"
                                   value="true" @(current.Id == 0 || current.IsActive ? "checked" : null)>
                            <label class="form-check-label small" for="activeSwitch">Show on public site</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/Committee" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> @(current.Id > 0 ? "Update Member" : "Add Member")
                </button>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        @if (showForm)
        {
            <text>
                const form = document.querySelector('.list-card[style*="var(--kpgja-gold)"]');
                if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            </text>
        }
    </script>
}