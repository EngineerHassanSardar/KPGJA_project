@{ Layout = "_AdminLayout"; ViewData["Title"] = "Reports"; }

<p class="text-secondary mb-3">Generate and export reports for KPGJA operations.</p>

<div class="row g-3">
    <div class="col-md-6 col-xl-4">
        <div class="soft-card p-4">
            <div class="stat-icon gold"><i class="bi bi-file-earmark-bar-graph"></i></div>
            <h6 class="fw-bold mb-1" style="font-size:12.5px;">Membership Report</h6>
            <p class="small text-muted mb-3" style="font-size:10.5px;">Overview of new, active and rejected members.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-excel"></i> Excel</button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="soft-card p-4">
            <div class="stat-icon green"><i class="bi bi-cash-coin"></i></div>
            <h6 class="fw-bold mb-1" style="font-size:12.5px;">Revenue Report</h6>
            <p class="small text-muted mb-3" style="font-size:10.5px;">Monthly fee collections and outstanding dues.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-excel"></i> Excel</button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="soft-card p-4">
            <div class="stat-icon blue"><i class="bi bi-calendar-check"></i></div>
            <h6 class="fw-bold mb-1" style="font-size:12.5px;">Events Report</h6>
            <p class="small text-muted mb-3" style="font-size:10.5px;">Attendance and participation across events.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-excel"></i> Excel</button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-4">
        <div class="soft-card p-4">
            <div class="stat-icon red"><i class="bi bi-graph-down"></i></div>
            <h6 class="fw-bold mb-1" style="font-size:12.5px;">Rejection Analysis</h6>
            <p class="small text-muted mb-3" style="font-size:10.5px;">Reasons and trends for rejected applications.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
                <button class="btn btn-outline-dark btn-sm flex-fill"><i class="bi bi-file-earmark-excel"></i> Excel</button>
            </div>
        </div>
    </div>
</div>