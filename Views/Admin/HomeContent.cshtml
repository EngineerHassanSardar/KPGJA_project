<!-- ========== 4. MEMBERSHIP CTA ========== -->
@if (showCtaForm)
{
    <form method="post" asp-action="HomeCtaSave">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@cta.Id" />

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-pencil-square"></i> Edit Membership CTA Banner</h2>
                    <p class="list-card-sub">The join-membership banner shown on the homepage.</p>
                </div>
                <a href="/Admin/HomeContent" class="btn-cancel">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Heading</label>
                        <input name="Heading" class="form-control" value="@cta.Heading">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Button Text</label>
                        <input name="CtaText" class="form-control" value="@cta.CtaText">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Body</label>
                        <textarea name="Body" class="form-control" rows="3">@cta.Body</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Button Link</label>
                        <input name="CtaLink" class="form-control" value="@cta.CtaLink">
                    </div>
                </div>
            </div>
            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/HomeContent" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> Save CTA Banner
                </button>
            </div>
        </div>
    </form>
}
<!-- ========== ICON PICKER MODAL ========== -->
<div class="modal fade" id="iconPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-grid"></i> Pick an Icon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="iconSearch" class="form-control mb-3"
                       placeholder="Search icons (e.g. globe, arrow, people, gem)">

                <div id="iconGrid" class="icon-grid">
                    <!-- JS will fill this -->
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        @if (showSlideForm || showObjectiveForm || showQuickLinkForm || showCtaForm)
        {
            <text>
                const form = document.querySelector('.list-card[style*="var(--kpgja-gold)"]');
                if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            </text>
        }
            // Icon picker
            (function() {
                const icons = [
                    "bi-globe", "bi-globe2", "bi-globe-americas", "bi-globe-asia-australia", "bi-globe-central-south-asia", "bi-globe-europe-africa",
                    "bi-graph-up", "bi-graph-up-arrow", "bi-graph-down", "bi-bar-chart", "bi-bar-chart-line", "bi-pie-chart",
                    "bi-mortarboard", "bi-book", "bi-bookmark", "bi-journal", "bi-lightbulb",
                    "bi-people", "bi-person", "bi-person-badge", "bi-person-circle", "bi-people-fill",
                    "bi-gem", "bi-award", "bi-award-fill", "bi-trophy", "bi-star", "bi-star-fill",
                    "bi-tools", "bi-gear", "bi-wrench", "bi-hammer", "bi-hammer-screw",
                    "bi-shop", "bi-cart", "bi-bag", "bi-basket",
                    "bi-bank", "bi-building", "bi-briefcase", "bi-house", "bi-house-door",
                    "bi-envelope", "bi-telephone", "bi-chat", "bi-chat-dots", "bi-send",
                    "bi-calendar", "bi-calendar-event", "bi-clock", "bi-hourglass",
                    "bi-cash", "bi-cash-coin", "bi-currency-dollar", "bi-credit-card", "bi-wallet",
                    "bi-hand-thumbs-up", "bi-handshake", "bi-shield-check", "bi-shield-lock",
                    "bi-truck", "bi-box", "bi-archive", "bi-box-seam",
                    "bi-pencil", "bi-pencil-square", "bi-pen", "bi-eyedropper",
                    "bi-megaphone", "bi-bullseye", "bi-target", "bi-cpu",
                    "bi-map", "bi-geo-alt", "bi-pin-map", "bi-compass",
                    "bi-heart", "bi-heart-fill", "bi-emoji-smile", "bi-hand-index",
                    "bi-check-circle", "bi-check2-circle", "bi-x-circle", "bi-exclamation-circle",
                    "bi-info-circle", "bi-question-circle", "bi-plus-circle", "bi-dash-circle",
                    "bi-arrow-right", "bi-arrow-left", "bi-arrow-up", "bi-arrow-down",
                    "bi-search", "bi-filter", "bi-funnel", "bi-sliders", "bi-list",
                    "bi-image", "bi-camera", "bi-file-earmark", "bi-file-text", "bi-folder",
                    "bi-wifi", "bi-cloud", "bi-sun", "bi-moon", "bi-stars",
                    "bi-diamond", "bi-suit-diamond", "bi-heart-pulse", "bi-activity",
                    "bi-boxes", "bi-layers", "bi-grid", "bi-grid-1x2", "bi-columns-gap",
                    "bi-tag", "bi-tags", "bi-bookmark-star", "bi-pin-angle",
                    "bi-tree", "bi-flower1", "bi-water", "bi-fire", "bi-snow",
                    "bi-palette", "bi-brush", "bi-easel", "bi-crop",
                    "bi-key", "bi-lock", "bi-unlock", "bi-fingerprint",
                    "bi-file-code", "bi-terminal", "bi-braces", "bi-code-slash",
                    "bi-eye", "bi-eye-slash", "bi-broadcast", "bi-rss"
                ];

                const grid = document.getElementById('iconGrid');
                const search = document.getElementById('iconSearch');
                const input = document.getElementById('iconClassInput');
                const preview = document.getElementById('iconPreview');

                if (!grid) return;

                function render(filter = "") {
                    const f = filter.toLowerCase();
                    const filtered = icons.filter(i => i.includes(f));
                    grid.innerHTML = filtered.map(i =>
                        `<div class="icon-item" data-icon="${i}">
                        <i class="bi ${i}"></i>
                        <span>${i.replace('bi-', '')}</span>
                    </div>`
                    ).join('');
                }

                render();

                search?.addEventListener('input', e => render(e.target.value));

                grid.addEventListener('click', e => {
                    const item = e.target.closest('.icon-item');
                    if (!item) return;
                    const icon = item.dataset.icon;
                    input.value = icon;
                    preview.className = 'bi ' + icon;
                    bootstrap.Modal.getInstance(document.getElementById('iconPickerModal')).hide();
                });
            })();
    </script>
}