                    </p>

                </div>

            </div>


            <!-- 06 -->

            <div class="col-md-6 col-lg-4">

                <div class="industry-card h-100">

                    <div class="industry-icon">

                        <i class="bi bi-megaphone"></i>

                    </div>


                    <h5>

                        Association Updates

                    </h5>


                    <p>

                        Receive relevant news, announcements and
                        membership updates.

                    </p>

                </div>

            </div>


        </div>

    </div>

</section>


<!-- =========================================================
     FINAL CTA
========================================================= -->

<section class="contact-cta py-5">

    <div class="container">


        <div class="row align-items-center g-4">


            <div class="col-lg-8">


                <span class="section-kicker text-warning">

                    JOIN KPGJA

                </span>


                <h2>

                    Become a KPGJA Member

                </h2>


                <p>

                    Create your account and start your online
                    membership application.

                </p>

            </div>


            <div class="col-lg-4 text-lg-end">


                <a href="/Member/Register"
                   class="btn btn-gold btn-lg">

                    Apply for Membership

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>


                <a href="/Member/Login"
                   class="btn btn-outline-light btn-lg ms-2">

                    Login

                </a>

            </div>

        </div>

    </div>

</section>


