                    </p>

                </div>

            </div>


            <!-- 04 -->

            <div class="col-md-6 col-lg-4">

                <div class="industry-card h-100">

                    <div class="industry-icon">

                        <i class="bi bi-person-vcard"></i>

                    </div>


                    <h5>

                        Digital Member Profile

                    </h5>


                    <p>

                        Manage your membership information through
