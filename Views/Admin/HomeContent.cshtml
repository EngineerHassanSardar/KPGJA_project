@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Home Content";
    bool showSlideForm     = ViewBag.ShowSlideForm == true;
    bool showObjectiveForm = ViewBag.ShowObjectiveForm == true;
    bool showQuickLinkForm = ViewBag.ShowQuickLinkForm == true;
    bool showCtaForm       = ViewBag.ShowCtaForm == true;

    var slides           = ViewBag.Slides as List<Entities.Entities.HeroSlide> ?? new();
    var objectives       = ViewBag.Objectives as List<Entities.Entities.HomeSection> ?? new();
    var quickLinks       = ViewBag.QuickLinks as List<Entities.Entities.HomeSection> ?? new();
    var currentSlide     = ViewBag.CurrentSlide as Entities.Entities.HeroSlide ?? new Entities.Entities.HeroSlide();
    var currentObjective = ViewBag.CurrentObjective as Entities.Entities.HomeSection ?? new Entities.Entities.HomeSection();
    var currentQuickLink = ViewBag.CurrentQuickLink as Entities.Entities.HomeSection ?? new Entities.Entities.HomeSection();
    var cta              = ViewBag.Cta as Entities.Entities.HomeCta ?? new Entities.Entities.HomeCta();
}

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="bi bi-exclamation-triangle me-1"></i> @err
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-head">
    <div class="page-head-left">
        <div class="kicker">Content</div>
        <h1>Home Content</h1>
        <p>Manage the homepage hero slider, objectives, membership CTA, page blocks and quick links.</p>
    </div>
    <div class="page-head-actions">
        <a href="/Admin/HomeContent?showCtaForm=true" class="btn-outline-brand">
            <i class="bi bi-pencil"></i> Edit CTA
        </a>
        <a href="/Admin/HomeContent?showSlideForm=true" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Slide
        </a>
    </div>
</div>

<div class="info-banner">
    <i class="bi bi-info-circle-fill"></i>
    <div>
        <strong>Homepage</strong>
        <p>Changes made here are reflected on the public <code>/Home</code> page.</p>
    </div>
</div>

<!-- ========== 0. PAGE BLOCKS ========== -->
<div class="list-card mb-3">
    <div class="list-card-head">
        <div>
            <h2><i class="bi bi-layers"></i> Page Blocks</h2>
            <p class="list-card-sub">Edit content blocks shown on the homepage.</p>
        </div>
    </div>
    <div class="p-4">
        <div class="row g-3">
            <div class="col-md-3">
                <a href="/Admin/HomeBlockEdit?key=intro" class="btn btn-outline-brand w-100">
                    <i class="bi bi-info-circle"></i> Introduction
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Admin/HomeBlockEdit?key=president" class="btn btn-outline-brand w-100">
                    <i class="bi bi-person-badge"></i> President's Message
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Admin/HomeBlockEdit?key=women" class="btn btn-outline-brand w-100">
                    <i class="bi bi-gender-female"></i> Women Section
                </a>
            </div>
            <div class="col-md-3">
                <a href="/Admin/HomeBlockEdit?key=contact-cta" class="btn btn-outline-brand w-100">
                    <i class="bi bi-envelope"></i> Contact CTA
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ========== 1. HERO SLIDER FORM ========== -->
@if (showSlideForm)
{
    <form method="post" asp-action="HomeSlideSave" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@currentSlide.Id" />
        <input type="hidden" name="ImagePath" value="@currentSlide.ImagePath" />

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2>
                        <i class="bi @(currentSlide.Id > 0 ? "bi-pencil-square" : "bi-plus-circle")"></i>
                        @(currentSlide.Id > 0 ? "Edit Slide" : "Add New Slide")
                    </h2>
                    <p class="list-card-sub">@(currentSlide.Id > 0 ? "Update the slider slide." : "Enter the slider slide information below.")</p>
                </div>
                <a href="/Admin/HomeContent" class="btn-cancel">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
                        <input name="Title" class="form-control" value="@currentSlide.Title" placeholder="Slide title" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control"
                               value="@(currentSlide.DisplayOrder == 0 ? (slides.Count + 1) : currentSlide.DisplayOrder)" min="0">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Kicker (small line above title)</label>
                        <input name="Subtitle" class="form-control" value="@currentSlide.Subtitle" placeholder="KHYBER PAKHUNKHWA · PAKISTAN">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Description (paragraph below title)</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Building stronger connections...">@currentSlide.Description</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Primary Button Text</label>
                        <input name="CtaText" class="form-control" value="@currentSlide.CtaText" placeholder="Become a Member">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Primary Button Link</label>
                        <input name="CtaLink" class="form-control" value="@currentSlide.CtaLink" placeholder="/Member/Register">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Secondary Button Text (optional)</label>
                        <input name="CtaText2" class="form-control" value="@currentSlide.CtaText2" placeholder="Discover KPGJA">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Secondary Button Link (optional)</label>
                        <input name="CtaLink2" class="form-control" value="@currentSlide.CtaLink2" placeholder="/Home/About">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Background Image</label>
                        <div class="d-flex gap-3 align-items-center">
                            @if (!string.IsNullOrEmpty(currentSlide.ImagePath))
                            {
                                <img src="@currentSlide.ImagePath" alt="Current"
                                     style="width:100px;height:60px;object-fit:cover;border-radius:8px;border:1px solid #ecebe6;">
                            }
                            <input type="file" name="ImageFile" class="form-control form-control-sm" accept="image/*">
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <input name="IsActive" class="form-check-input" type="checkbox" value="true"
                                   @(currentSlide.Id == 0 || currentSlide.IsActive ? "checked" : null)>
                            <label class="form-check-label small">Show on homepage</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/HomeContent" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> @(currentSlide.Id > 0 ? "Update Slide" : "Save Slide")
                </button>
            </div>
        </div>
    </form>
}

<!-- HERO SLIDER TABLE -->
<div class="list-card mb-3">
    <div class="list-card-head">
        <div>
            <h2>
                <i class="bi bi-images"></i> Hero Slider
                <span class="count-badge">@(slides?.Count ?? 0)</span>
            </h2>
            <p class="list-card-sub">The rotating banner at the top of the homepage.</p>
        </div>
        <a href="/Admin/HomeContent?showSlideForm=true" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Slide
        </a>
    </div>

    @if (slides == null || !slides.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-images"></i></div>
            <h3>No slides yet</h3>
            <p>Click "Add Slide" to create your first hero slide.</p>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th style="width:80px;">Image</th>
                    <th>Title</th>
                    <th style="width:160px;">CTA Button</th>
                    <th class="center" style="width:80px;">Order</th>
                    <th class="center" style="width:100px;">Status</th>
                    <th class="right" style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int n = 0; }
                @foreach (var sl in slides.OrderBy(x => x.DisplayOrder))
                {
                    n++;
                    <tr>
                        <td class="row-num">@n</td>
                        <td>
                            @if (!string.IsNullOrEmpty(sl.ImagePath))
                            {
                                <img src="@sl.ImagePath" alt="@sl.Title"
                                     style="width:60px;height:40px;object-fit:cover;border-radius:6px;border:1px solid #ecebe6;">
                            }
                            else
                            {
                                <div class="thumb"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td>
                            <div class="strong">@sl.Title</div>
                            <div class="desc-cell" style="margin-top:2px;">@sl.Subtitle</div>
                        </td>
                        <td class="text-muted"><span style="color:var(--kpgja-gold);font-weight:600;">@sl.CtaText</span></td>
                        <td class="center text-muted">@sl.DisplayOrder</td>
                        <td class="center">
                            @if (sl.IsActive)
                            {
                                <span class="pill active">Active</span>
                            }
                            else
                            {
                                <span class="pill inactive">Inactive</span>
                            }
                        </td>
                        <td class="right">
                            <div class="row-actions">
                                <a href="/Admin/HomeContent?showSlideForm=true&id=@sl.Id" class="icon-btn edit" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Admin/HomeSlideDelete" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@sl.Id" />
                                    <button type="submit" class="icon-btn delete" title="Delete"
                                            onclick="return confirm('Delete this slide?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ========== 2. OBJECTIVES ========== -->
