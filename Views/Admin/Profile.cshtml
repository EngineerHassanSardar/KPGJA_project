@{ Layout = "_AdminLayout"; ViewData["Title"] = "My Profile"; }

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @success
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-action="ProfileSave">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="soft-card p-4 mb-3">
                <h5 class="card-head-title small fw-bold mb-3"><i class="bi bi-person me-1"></i> Profile Information</h5>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label small fw-semibold">Full Name</label><input class="form-control" value="Administrator"></div>
                    <div class="col-md-6"><label class="form-label small fw-semibold">Email</label><input class="form-control" value="admin@kpgja.com"></div>
                    <div class="col-md-6"><label class="form-label small fw-semibold">Phone</label><input class="form-control" value="+92 300 1234567"></div>
                    <div class="col-md-6"><label class="form-label small fw-semibold">Role</label><input class="form-control" value="Super Admin" disabled></div>
                </div>
            </div>

            <div class="soft-card p-4">
                <h5 class="card-head-title small fw-bold mb-3"><i class="bi bi-shield-lock me-1"></i> Change Password</h5>
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label small fw-semibold">Current Password</label><input type="password" class="form-control"></div>
                    <div class="col-md-4"><label class="form-label small fw-semibold">New Password</label><input type="password" class="form-control"></div>
                    <div class="col-md-4"><label class="form-label small fw-semibold">Confirm Password</label><input type="password" class="form-control"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="soft-card p-4 text-center">
                <div class="user-avatar mx-auto mb-3" style="width:80px;height:80px;font-size:32px;">A</div>
                <div class="fw-bold">Administrator</div>
                <div class="small text-muted">admin@kpgja.com</div>
                <div class="mt-3">
                    <input type="file" class="form-control form-control-sm" accept="image/*">
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="submit" class="btn btn-gold btn-sm px-3"><i class="bi bi-check2 me-1"></i> Update Profile</button>
    </div>
</form>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
