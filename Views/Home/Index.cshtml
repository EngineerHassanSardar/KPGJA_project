@{
    ViewData["Title"] = "Home | Khyber Pakhtunkhwa Gems & Jewellery Association";

    var slides = ViewBag.Slides as List<Entities.Entities.HeroSlide> ?? new();
    var objectives = ViewBag.Objectives as List<Entities.Entities.HomeSection> ?? new();
    var quickLinks = ViewBag.QuickLinks as List<Entities.Entities.HomeSection> ?? new();
    var cta = ViewBag.Cta as Entities.Entities.HomeCta ?? new Entities.Entities.HomeCta();
    var intro = ViewBag.Intro as Entities.Entities.HomeBlock;
    var president = ViewBag.President as Entities.Entities.HomeBlock;
    var women = ViewBag.Women as Entities.Entities.HomeBlock;
    var contactCta = ViewBag.ContactCta as Entities.Entities.HomeBlock;
    var committee = ViewBag.Committee as List<Entities.Entities.CommitteeMember> ?? new();
    var eventsList = ViewBag.UpcomingEvents as List<Entities.Entities.EventItem> ?? new();
    var newsList = ViewBag.LatestNews as List<Entities.Entities.NewsArticle> ?? new();
    var miniFeatures = ViewBag.WomenMinis as List<Entities.Entities.WomenMiniFeature> ?? new();
}

@section Styles {
    <style>
        .president-message {
            background: #172033;
            border-radius: 20px;
            overflow: hidden;
            color: #fff;
            box-shadow: 0 12px 35px rgba(0,0,0,.08);
        }

        .president-photo {
            height: 100%;
            min-height: 340px;
            background: #101827;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .president-photo img {
                width: 100%;
                height: 100%;
                min-height: 340px;
                object-fit: cover;
                object-position: center;
            }

        .president-content {
            padding: 40px 45px;
        }

            .president-content h3 {
                font-family: "Playfair Display", serif;
                font-size: 28px;
                line-height: 1.35;
                color: #fff;
            }

        .president-quote {
            padding-left: 20px;
            border-left: 3px solid #d6a84f;
        }

            .president-quote p {
                color: rgba(255,255,255,.78);
                font-size: 15px;
                line-height: 1.8;
                margin-bottom: 0;
            }

        .president-name h5 {
            color: #fff;
            font-weight: 700;
        }

        .president-name span {
            color: #d6a84f;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .committee-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0,0,0,.08);
        }

            .committee-card img {
                width: 100%;
                height: 340px;
                object-fit: contain;
                object-position: center;
                background: #f3f4f6;
                display: block;
            }

        .committee-info {
            padding: 18px 20px;
        }

            .committee-info h5 {
                margin-bottom: 5px;
                font-weight: 700;
            }

            .committee-info span {
                color: #d6a84f;
                font-size: 13px;
                font-weight: 600;
            }

        /* ============ LIVE MEMBERS COUNTER ============ */
        .live-counter-wrap {
            margin-top: 32px;
            display: flex;
            justify-content: flex-start;
        }

        .live-counter {
            display: inline-flex;
            align-items: center;
            gap: 18px;
            padding: 18px 26px;
            background: linear-gradient(135deg, rgba(20, 60, 45, 0.85), rgba(10, 40, 30, 0.9));
            border: 1px solid rgba(120, 220, 170, 0.25);
            border-radius: 16px;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35),
                        inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        .live-counter-icon {
            width: 54px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(120, 220, 170, 0.12);
            border-radius: 12px;
            color: #7de3b3;
            font-size: 26px;
            flex-shrink: 0;
        }

        .live-counter-body {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .live-counter-title {
            font-size: 15px;
            font-weight: 500;
            color: #e8fff4;
            letter-spacing: 0.2px;
            margin-bottom: 2px;
        }

        .live-counter-digits {
            display: flex;
            gap: 6px;
        }

            .live-counter-digits .digit {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 36px;
                height: 46px;
                padding: 0 8px;
                background: #0a1f17;
                color: #e8fff4;
                font-family: "Playfair Display", "Georgia", serif;
                font-size: 26px;
                font-weight: 700;
                border-radius: 8px;
                border: 1px solid rgba(120, 220, 170, 0.15);
                box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.4),
                            inset 0 1px 0 rgba(255, 255, 255, 0.04);
                text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
            }

        .live-counter-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: #7de3b3;
            margin-top: 2px;
        }

            .live-counter-status .dot {
                display: inline-block;
                width: 8px;
                height: 8px;
                background: #35e08f;
                border-radius: 50%;
                box-shadow: 0 0 8px #35e08f;
                animation: pulse 1.6s ease-in-out infinite;
            }

        @@keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.55; transform: scale(0.85); }
        }

        @@media (max-width: 767px) {
            .president-photo, .president-photo img {
                min-height: 280px;
            }

            .president-content {
                padding: 30px 25px;
            }

                .president-content h3 {
                    font-size: 24px;
                }

            .live-counter { padding: 14px 18px; gap: 12px; }
            .live-counter-digits .digit { min-width: 30px; height: 40px; font-size: 20px; }
            .live-counter-icon { width: 44px; height: 44px; font-size: 20px; }
            .live-counter-title { font-size: 13px; }
        }
    </style>
}

<!-- ================= HERO SLIDER ================= -->
<section class="hero-section">
    @if (slides.Any())
    {
        <div id="heroSlider" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="6000">
            @if (slides.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (int i = 0; i < slides.Count; i++)
                    {
                        <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
                    }
                </div>
            }
            <div class="carousel-inner">
                @for (int i = 0; i < slides.Count; i++)
                {
                    var sl = slides[i];
                    var bg = string.IsNullOrEmpty(sl.ImagePath) ? "/assets/img/slider/image-placeholder.svg" : sl.ImagePath;
                    <div class="carousel-item @(i == 0 ? "active" : "") hero-slide"
                         style="background-image:url('@bg');">
                        <div class="hero-overlay"></div>
                        <div class="container">
                            <div class="hero-content">
                                @if (!string.IsNullOrEmpty(sl.Subtitle))
                                {
                                    <span class="hero-kicker">@sl.Subtitle</span>
                                }
                                <h1>@Html.Raw(sl.Title)</h1>
                                @if (!string.IsNullOrEmpty(sl.Description))
                                {
                                    <p>@sl.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(sl.CtaText) || !string.IsNullOrEmpty(sl.CtaText2))
                                {
                                    <div class="d-flex gap-3 flex-wrap">
                                        @if (!string.IsNullOrEmpty(sl.CtaText))
                                        {
                                            <a href="@sl.CtaLink" class="btn btn-gold btn-lg">
                                                @sl.CtaText <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(sl.CtaText2))
                                        {
                                            <a href="@sl.CtaLink2" class="btn btn-outline-light btn-lg">
                                                @sl.CtaText2
                                            </a>
                                        }
                                    </div>
                                }

                                <!-- ============ LIVE MEMBERS COUNTER (static) ============ -->
                                <div class="live-counter-wrap">
                                    <div class="live-counter">
                                        <div class="live-counter-icon">
                                            <i class="bi bi-people-fill"></i>
                                        </div>
                                        <div class="live-counter-body">
                                            <div class="live-counter-title">Registered Members with KPGJA</div>
                                            <div class="live-counter-digits">
                                                <span class="digit">0</span>
                                                <span class="digit">0</span>
                                                <span class="digit">0</span>
                                                <span class="digit">0</span>
                                                <span class="digit">0</span>
                                            </div>
                                            <div class="live-counter-status">
                                                <span class="dot"></span> Live Counter
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- ============ /LIVE MEMBERS COUNTER ============ -->

                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (slides.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#heroSlider" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#heroSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            }
        </div>
    }
</section>

<!-- ================= INTRODUCTION ================= -->
@if (intro != null)
{
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="section-kicker">ABOUT KPGJA</span>
                    <h2 class="section-heading">@intro.Title</h2>
                    <p class="lead text-secondary">@intro.Body</p>
                    <p class="text-secondary">@intro.Body2</p>
                    @if (!string.IsNullOrEmpty(intro.CtaText))
                    {
                        <a href="@intro.CtaLink" class="btn btn-dark">
                            @intro.CtaText <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
                @if (!string.IsNullOrEmpty(intro.ImagePath))
                {
                    <div class="col-lg-6">
                        <div class="intro-image-wrapper">
                            <img src="@intro.ImagePath" alt="About KPGJA" class="img-fluid">
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ================= PRESIDENT'S MESSAGE ================= -->
@if (president != null)
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <span class="section-kicker">LEADERSHIP</span>
                <h2 class="section-heading">President's Message</h2>
            </div>
            <div class="president-message">
                <div class="row g-0 align-items-stretch">
                    @if (!string.IsNullOrEmpty(president.ImagePath))
                    {
                        <div class="col-lg-4">
                            <div class="president-photo">
                                <img src="@president.ImagePath" alt="@president.PersonName">
                            </div>
                        </div>
                    }
                    <div class="col-lg-8">
                        <div class="president-content">
                            <div class="mb-3"><i class="bi bi-quote" style="font-size:32px;color:#d6a84f;"></i></div>
                            <h3 class="mb-3">@president.Title</h3>
                            <div class="president-quote">
                                <p>@president.Body</p>
                                @if (!string.IsNullOrEmpty(president.Body2))
                                {
                                    <p class="mt-3">@president.Body2</p>
                                }
                            </div>
                            <div class="president-name mt-4">
                                <h5 class="mb-1">@president.PersonName</h5>
                                <span>@president.PersonTitle</span>
                            </div>

                            @if (!string.IsNullOrEmpty(president.CtaText))
                            {
                                <a href="@president.CtaLink" class="btn btn-gold mt-4">
                                    @president.CtaText
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- ================= OBJECTIVES ================= -->
<section class="objectives-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-kicker">OUR OBJECTIVES</span>
            <h2 class="section-heading">Supporting industry development</h2>
        </div>
        @if (objectives.Any())
        {
            <div class="row g-4">
                @foreach (var obj in objectives)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="objective-card">
                            <div class="objective-icon">
                                <i class="bi @(string.IsNullOrEmpty(obj.IconClass) ? "bi-star" : obj.IconClass)"></i>
                            </div>
                            <h4>@obj.Title</h4>
                            <p>@obj.Body</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ================= MEMBERSHIP CTA ================= -->
@if (!string.IsNullOrEmpty(cta.Heading))
{
    <section class="membership-section">
        <div class="container">
            <div class="membership-box">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <span class="section-kicker text-warning">MEMBERSHIP</span>
                        <h2>@cta.Heading</h2>
                        <p>@cta.Body</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="@cta.CtaLink" class="btn btn-gold btn-lg">
                            @cta.CtaText <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- ================= INDUSTRY (static) ================= -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <span class="section-kicker">OUR INDUSTRY</span>
                <h2 class="section-heading mb-0">Explore the sector</h2>
            </div>
            <a href="/Home/Industry" class="btn btn-outline-dark">View Industry <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            <div class="col-6 col-lg"><a href="/Home/Industry" class="industry-card text-decoration-none"><div class="industry-icon"><i class="bi bi-gem"></i></div><h5>Gemstones</h5><p>Natural & precious stones</p></a></div>
            <div class="col-6 col-lg"><a href="/Home/Industry" class="industry-card text-decoration-none"><div class="industry-icon"><i class="bi bi-award"></i></div><h5>Jewellery</h5><p>Traditional & modern</p></a></div>
            <div class="col-6 col-lg"><a href="/Home/Industry" class="industry-card text-decoration-none"><div class="industry-icon"><i class="bi bi-tools"></i></div><h5>Lapidary</h5><p>Cutting & polishing</p></a></div>
            <div class="col-6 col-lg"><a href="/Home/Industry" class="industry-card text-decoration-none"><div class="industry-icon"><i class="bi bi-shop"></i></div><h5>Manufacturing</h5><p>Production & craftsmanship</p></a></div>
            <div class="col-6 col-lg"><a href="/Home/Industry" class="industry-card text-decoration-none"><div class="industry-icon"><i class="bi bi-globe2"></i></div><h5>Trade & Export</h5><p>Domestic & global markets</p></a></div>
        </div>
    </div>
</section>

<!-- ================= WOMEN EMPOWERMENT ================= -->
@if (women != null)
{
    <section class="women-section py-5">
        <div class="container">
            <div class="row align-items-center g-5">
                @if (!string.IsNullOrEmpty(women.ImagePath))
                {
                    <div class="col-lg-6 order-lg-2">
                        <img src="@women.ImagePath" alt="Women empowerment" class="img-fluid rounded-4 shadow">
                    </div>
                }
                <div class="col-lg-6 order-lg-1">
                    <span class="section-kicker">WOMEN EMPOWERMENT</span>
                    <h2 class="section-heading">@women.Title</h2>
                    <p class="text-secondary">@women.Body</p>

                    @if (miniFeatures.Any())
                    {
                        <div class="row g-3 mt-2">
                            @foreach (var mf in miniFeatures)
                            {
                                <div class="col-6">
                                    @if (!string.IsNullOrEmpty(mf.Link))
                                    {
                                        <a href="@mf.Link" class="mini-feature text-decoration-none">
                                            <i class="bi @mf.IconClass"></i>
                                            <strong>@mf.Label</strong>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="mini-feature">
                                            <i class="bi @mf.IconClass"></i>
                                            <strong>@mf.Label</strong>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(women.CtaText))
                    {
                        <a href="@women.CtaLink" class="btn btn-dark mt-4">
                            @women.CtaText <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- ================= EXECUTIVE COMMITTEE (DB) ================= -->
@if (committee.Any())
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-kicker">LEADERSHIP</span>
                <h2 class="section-heading">Executive Committee</h2>
            </div>
            <div class="row g-4">
                @foreach (var m in committee)
                {
                    <div class="col-md-4">
                        <div class="committee-card">
                            @if (!string.IsNullOrEmpty(m.PhotoPath))
                            {
                                <img src="@m.PhotoPath" alt="@m.FullName">
                            }
                            <div class="committee-info">
                                <h5>@m.FullName</h5>
                                <span>@m.Designation</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a href="/Home/Executive" class="btn btn-outline-dark">
                    View Executive Committee <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- ================= EVENTS & NEWS (DB) ================= -->
@if (eventsList.Any() || newsList.Any())
{
    <section class="news-events-section py-5">
        <div class="container">
            <div class="row g-5">
                @if (eventsList.Any())
                {
                    <div class="col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="section-kicker">EVENTS</span>
                                <h2 class="section-heading mb-0">Events & Activities</h2>
                            </div>
                            <a href="/Home/Events" class="btn btn-sm btn-outline-dark">View All</a>
                        </div>
                        @foreach (var e in eventsList)
                        {
                            <div class="event-item">
                                <div class="event-date">
                                    <strong>@e.StartDate.ToString("dd")</strong>
                                    <span>@e.StartDate.ToString("MMM").ToUpper()</span>
                                </div>
                                <div>
                                    <h5>@e.Title</h5>
                                    <p>@e.Location</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (newsList.Any())
                {
                    <div class="col-lg-6">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <span class="section-kicker">NEWS</span>
                                <h2 class="section-heading mb-0">Latest Updates</h2>
                            </div>
                            <a href="/Home/News" class="btn btn-sm btn-outline-dark">View All</a>
                        </div>
                        @foreach (var n in newsList)
                        {
                            <article class="news-item">
                                <div class="news-icon"><i class="bi bi-newspaper"></i></div>
                                <div>
                                    <span class="small text-muted">@n.Category</span>
                                    <h5>@n.Title</h5>
                                    <p>@n.Summary</p>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ================= IMPORTANT LINKS ================= -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-kicker">QUICK ACCESS</span>
            <h2 class="section-heading">Important Links</h2>
        </div>
        @if (quickLinks.Any())
        {
            <div class="row g-3">
                @foreach (var ql in quickLinks)
                {
                    <div class="col-md-6 col-lg-3">
                        <a href="@ql.Body" class="quick-link">
                            <span>@ql.Title</span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ================= CONTACT CTA ================= -->
@if (contactCta != null)
{
    <section class="contact-cta py-5">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="section-kicker text-warning">CONNECT WITH US</span>
                    <h2>@contactCta.Title</h2>
                    <p>@contactCta.Body</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="@contactCta.CtaLink" class="btn btn-gold btn-lg">
                        @contactCta.CtaText <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
}   