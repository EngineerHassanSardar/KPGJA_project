                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Already a Member? Login
                                </a>

                                <button type="submit" class="btn btn-gold btn-lg">
                                    <i class="bi bi-send me-1"></i>
                                    Submit Membership Application
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const categories = document.querySelectorAll('input[name="MembershipCategory"]');
            const feeSummary = document.getElementById("membershipFeeSummary");
            const admissionElement = document.getElementById("membershipAdmissionFee");
            const categoryLabel = document.getElementById("membershipCategoryLabel");

            function formatPKR(amount) {
                return "Rs. " + Number(amount).toLocaleString("en-PK");
            }

            function updateMembershipFee() {
                const selected = document.querySelector('input[name="MembershipCategory"]:checked');

                if (!selected) {
                    feeSummary.classList.add("d-none");
                    return;
                }

                const admission = parseFloat(selected.dataset.admission || "0");
                const label = selected.value;

                admissionElement.textContent = formatPKR(admission);
                categoryLabel.textContent = label;
                feeSummary.classList.remove("d-none");
            }

            categories.forEach(function (category) {
                category.addEventListener("change", updateMembershipFee);
            });

            updateMembershipFee();
        });
    </script>
}