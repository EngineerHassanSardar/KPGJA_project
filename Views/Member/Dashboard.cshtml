@using KPGJA.Web.Models
@{
    ViewData["Title"] = "Member Dashboard";
    var app = ViewData["Application"] as MembershipApplication;
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="section-kicker">MEMBER PORTAL</span>
            <h2 class="section-heading mb-1">Welcome, @User.Identity?.Name</h2>
            <p class="text-secondary mb-0">Track your KPGJA membership application from your portal.</p>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-dark">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </div>

    <!-- Flash message -->
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    <!-- No Application -->
    @if (app == null)
    {
        <div class="alert alert-info">No membership application is linked to this account.</div>
    }
    else
    {
        <!-- Welcome Banner -->
        <div class="dashboard-welcome mb-4">
            <span class="portal-status">
                <i class="bi bi-hourglass-split"></i> @app.Status
            </span>
            <h1 class="mt-2">@app.BusinessName</h1>
            <p>@app.MembershipCategory member application</p>
            <div class="member-id">
                <i class="bi bi-hash"></i> Application ID: @app.Id
            </div>
        </div>

        <div class="row g-4">

            <!-- Application Info -->
            <div class="col-lg-8">
                <div class="application-card">
                    <h5 class="portal-section-title">Application Details</h5>
                    <p class="portal-section-subtitle mb-4">
                        Submitted on @app.ApplicationDate.ToLocalTime().ToString("dd MMM yyyy")
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted">Applicant</div>
                            <strong>@app.FullName</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">CNIC</div>
                            <strong>@app.Cnic</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Business Name</div>
                            <strong>@app.BusinessName</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Membership Category</div>
                            <strong>@app.MembershipCategory</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Membership Fee</div>
                            <strong>PKR @app.MembershipFee.ToString("N0")</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Membership No.</div>
                            <strong>@(string.IsNullOrWhiteSpace(app.MembershipNo) ? "Pending assignment" : app.MembershipNo)</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Email</div>
                            <strong>@app.Email</strong>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Mobile</div>
                            <strong>@app.MobileNo</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(app.AdminRemarks))
                    {
                        <div class="alert alert-light border mt-4 mb-0">
                            <strong>Admin Remarks:</strong><br>@app.AdminRemarks
                        </div>
                    }
                </div>

                <!-- Timeline -->
                <div class="application-card mt-4">
                    <h5 class="portal-section-title">Application Progress</h5>
                    <p class="portal-section-subtitle">Where your application stands right now</p>

                    <div class="timeline">
                        <div class="timeline-step done">
                            <div class="timeline-circle"><i class="bi bi-check"></i></div>
                            <small>Submitted</small>
                        </div>
                        <div class="timeline-step @(app.Status == "Pending Review" ? "current" : "done")">
                            <div class="timeline-circle">2</div>
                            <small>Under Review</small>
                        </div>
                        <div class="timeline-step @(app.Status.Contains("Payment") ? "current" : "")">
                            <div class="timeline-circle">3</div>
                            <small>Payment</small>
                        </div>
                        <div class="timeline-step @(app.Status == "Active Member" || app.Status == "Approved" ? "current" : "")">
                            <div class="timeline-circle">4</div>
                            <small>Approved</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">

                <!-- Status Info -->
                <div class="dashboard-card mb-4">
                    <div class="dashboard-card-icon"><i class="bi bi-info-circle"></i></div>
                    <div class="dashboard-card-label">Current Status</div>
                    <div class="dashboard-card-value">@app.Status</div>
                </div>

                <!-- Next Step -->
                <div class="dashboard-card mb-4">
                    <div class="dashboard-card-icon"><i class="bi bi-arrow-right-circle"></i></div>
                    <div class="dashboard-card-label">Next Step</div>
                    <div class="dashboard-card-value" style="font-size:14px;line-height:1.5;">
                        @switch (app.Status)
                        {
                            case "Pending Review":
                                @:Your application is being reviewed by KPGJA admin.
                                break;
                            case "Approved for Payment":
                                @:Please submit your membership fee to proceed.
                                break;
                            case "Payment Submitted":
                                @:Your payment is being verified.
                                break;
                            case "Payment Verified":
                                @:Your payment has been verified. Awaiting final approval.
                                break;
                            case "Active Member":
                                @:Welcome! Your membership is active.
                                break;
                            case "Approved":
                                @:Your membership has been approved.
                                break;
                            case "Rejected":
                                @:Your application was not approved. Contact KPGJA for details.
                                break;
                            default:
                                @:Awaiting next steps from KPGJA.
                                break;
                        }
                    </div>
                </div>

                <!-- Help -->
                <div class="dashboard-card">
                    <div class="dashboard-card-icon"><i class="bi bi-headset"></i></div>
                    <div class="dashboard-card-label">Need Help?</div>
                    <div class="dashboard-card-value" style="font-size:14px;line-height:1.5;">
                        Contact KPGJA office:
                        <div class="mt-2 small">
                            <i class="bi bi-envelope me-1"></i> info@kpgja.com<br>
                            <i class="bi bi-telephone me-1"></i> +92 91 1234567
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>