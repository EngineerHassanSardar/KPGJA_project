        <div class="row g-4">


            <!-- 01 -->

            <div class="col-md-6 col-lg-4">

                <div class="industry-card h-100">

                    <div class="industry-icon">

                        <i class="bi bi-people"></i>

                    </div>


                    <h5>

                        Industry Networking

                    </h5>


                    <p>

                        Connect with businesses and stakeholders
