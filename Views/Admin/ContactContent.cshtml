@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Contact Content";
    bool showForm = ViewBag.ShowForm == true;
}

@if (TempData["Success"] is string s)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @s
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-head">
    <div class="page-head-left">
        <div class="kicker">Content</div>
        <h1>Contact Content</h1>
        <p>Manage the address, phone, email and hours shown on the public Contact page.</p>
    </div>
    <div class="page-head-actions">
        @if (!showForm)
        {
            <a href="/Admin/ContactContent?showForm=true" class="btn-outline-brand">
                <i class="bi bi-pencil"></i> Edit Content
            </a>
        }
        else
        {
            <a href="/Admin/ContactContent" class="btn-cancel">
                <i class="bi bi-x-lg"></i> Cancel
            </a>
        }
    </div>
</div>

<div class="info-banner">
    <i class="bi bi-info-circle-fill"></i>
    <div>
        <strong>Contact Page</strong>
        <p>Changes made here appear on the public <code>/Home/Contact</code> page. To view submitted messages, go to <a href="/Admin/Contact">Contact Inquiries</a>.</p>
    </div>
</div>

@if (showForm)
{
    <form method="post" asp-action="ContactContentSave">
        @Html.AntiForgeryToken()

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-heading"></i> Page Header</h2>
                    <p class="list-card-sub">Kicker, title and intro text at the top of the Contact page.</p>
                </div>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Kicker</label>
                        <input name="Kicker" class="form-control" value="WE ARE HERE TO HELP">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Main Heading</label>
                        <input name="Heading" class="form-control" value="Let's connect with the industry">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Intro Paragraph</label>
                        <textarea name="Intro" class="form-control" rows="3">Whether you are interested in membership, business networking, industry activities, events or association information, contact KPGJA through the channels below.</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-geo-alt"></i> Head Office</h2>
                    <p class="list-card-sub">Office address and location details.</p>
                </div>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Address</label>
                        <textarea name="Address" class="form-control" rows="3">Hamza Market, 1st Floor, Office # B13, Shah Qabool Street, Namak Mandi, Peshawar, Pakistan</textarea>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Google Map Embed URL</label>
                        <input name="MapUrl" class="form-control" placeholder="https://maps.google.com/...">
                    </div>
                </div>
            </div>
        </div>

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-telephone"></i> Contact Details</h2>
                    <p class="list-card-sub">Email, phone and description text.</p>
                </div>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Email</label>
                        <input name="Email" type="email" class="form-control" value="info@kpgja.org">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phone</label>
                        <input name="Phone" class="form-control" value="+92 XXX XXXXXXX">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Email Description</label>
                        <input name="EmailDesc" class="form-control" value="General inquiries and association communication.">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Phone Description</label>
                        <input name="PhoneDesc" class="form-control" value="Contact the KPGJA office during official working hours.">
                    </div>
                </div>
            </div>
        </div>

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-clock"></i> Office Hours</h2>
                    <p class="list-card-sub">Weekday hours and any notes.</p>
                </div>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Weekdays</label>
                        <input name="Weekdays" class="form-control" value="Monday – Friday">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Hours</label>
                        <input name="Hours" class="form-control" value="9:00 AM – 5:00 PM">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Note</label>
                        <input name="Note" class="form-control" value="Office timings may vary on public holidays.">
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a href="/Admin/ContactContent" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-add">
                <i class="bi bi-check2"></i> Save Contact Content
            </button>
        </div>
    </form>
}
else
{
    <div class="list-card">
        <div class="list-card-head">
            <div>
                <h2><i class="bi bi-file-text"></i> Current Content</h2>
                <p class="list-card-sub">Preview of what's shown on the public Contact page.</p>
            </div>
        </div>
        <div class="p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Kicker</div>
                    <div class="fw-semibold">WE ARE HERE TO HELP</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Heading</div>
                    <div class="fw-semibold">Let's connect with the industry</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Email</div>
                    <div class="fw-semibold">info@kpgja.org</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Phone</div>
                    <div class="fw-semibold">+92 XXX XXXXXXX</div>
                </div>
                <div class="col-12">
                    <div class="small text-muted mb-1">Address</div>
                    <div class="fw-semibold">Hamza Market, 1st Floor, Office # B13, Shah Qabool Street, Namak Mandi, Peshawar, Pakistan</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Weekdays</div>
                    <div class="fw-semibold">Monday – Friday</div>
                </div>
                <div class="col-md-6">
                    <div class="small text-muted mb-1">Hours</div>
                    <div class="fw-semibold">9:00 AM – 5:00 PM</div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        @if (showForm)
        {
            <text>
                const form = document.querySelector('form');
                if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            </text>
        }
    </script>
}