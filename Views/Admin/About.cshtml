@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "About Us";
    var sections = ViewBag.Sections as List<Entities.Entities.AboutSection> ?? new();
    var current = ViewBag.CurrentSection as Entities.Entities.AboutSection ?? new Entities.Entities.AboutSection();
    bool showForm = ViewBag.ShowForm == true;
    bool editMode = current.Id > 0;
}

@if (TempData["Success"] is string s)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @s
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ==================== PAGE HEADER ==================== -->
<div class="page-head">
    <div class="page-head-left">
        <div class="kicker">Content</div>
        <h1>About Us</h1>
        <p>Manage the "Our Story" sections shown on the About page.</p>
    </div>
    <div class="page-head-actions">
        <a href="/Admin/About?showForm=true" class="btn-add">
            <i class="bi bi-plus-lg"></i> Add Section
        </a>
    </div>
</div>

<!-- ==================== INFO BANNER ==================== -->
<div class="info-banner">
    <i class="bi bi-info-circle-fill"></i>
    <div>
        <strong>About Page</strong>
        <p>Changes made here are reflected on the public <code>/Home/About</code> page.</p>
    </div>
</div>

<!-- ==================== SECTION FORM (Add / Edit) ==================== -->
@if (showForm)
{
    <form method="post" asp-action="AboutSectionSave" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@current.Id" />
        <input type="hidden" name="ImagePath" value="@current.ImagePath" />

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2>
                        <i class="bi @(editMode ? "bi-pencil-square" : "bi-plus-circle")"></i>
                        @(editMode ? "Edit Section" : "Add New Section")
                    </h2>
                    <p class="list-card-sub">@(editMode ? "Update this section." : "Enter the section information below.")</p>
                </div>
                <a href="/Admin/About" class="btn-cancel">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>

            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Title <span class="text-danger">*</span></label>
                        <input name="Title" class="form-control" value="@current.Title"
                               placeholder="e.g. Our Mission" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control"
                               value="@(current.DisplayOrder == 0 ? (sections.Count + 1) : current.DisplayOrder)" min="0">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-semibold">Body</label>
                        <textarea name="Body" class="form-control" rows="4"
                                  placeholder="Section content...">@current.Body</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Highlights (comma separated)</label>
                        <input name="Highlights" class="form-control" value="@current.Highlights"
                               placeholder="China Sourcing & Supplier Coordination, Import & Export Assistance, ...">
                        <div class="small text-muted mt-1" style="font-size:11px;">
                            Separate each highlight with a comma (,)
                        </div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Image</label>
                        <div class="d-flex gap-3 align-items-center">
                            @if (!string.IsNullOrEmpty(current.ImagePath))
                            {
                                <img src="@current.ImagePath" alt="Current image"
                                     style="width:80px;height:60px;object-fit:cover;border-radius:8px;border:1px solid #ecebe6;">
                            }
                            <input type="file" name="imageFile" class="form-control" accept="image/*">
                        </div>
                        <div class="small text-muted mt-1" style="font-size:10.5px;">Optional. JPG, PNG or WebP.</div>
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check form-switch">
                          
                            <input name="IsActive" class="form-check-input" type="checkbox"
                                   value="true" @(current.Id == 0 || current.IsActive ? "checked" : null)>
                            <label class="form-check-label small">Show on public site</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/About" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> @(editMode ? "Update Section" : "Save Section")
                </button>
            </div>
        </div>
    </form>
}

<!-- ==================== SECTIONS TABLE ==================== -->
<div class="list-card">
    <div class="list-card-head">
        <div>
            <h2>
                <i class="bi bi-list-ul"></i> All Sections
                <span class="count-badge">@(sections?.Count ?? 0)</span>
            </h2>
            <p class="list-card-sub">Each section appears as a block on the About page.</p>
        </div>
    </div>

    @if (sections == null || !sections.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-list-ul"></i></div>
            <h3>No content sections yet</h3>
            <p>Click "Add Section" to create your first section.</p>
            <a href="/Admin/About?showForm=true" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add First Section
            </a>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th style="width:70px;">Image</th>
                    <th style="width:auto;">Title</th>
                    <th class="center" style="width:80px;">Order</th>
                    <th class="center" style="width:100px;">Status</th>
                    <th class="right" style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int n = 0; }
                @foreach (var sec in sections.OrderBy(x => x.DisplayOrder))
                {
                    n++;
                    <tr>
                        <td class="row-num">@n</td>
                        <td>
                            @if (!string.IsNullOrEmpty(sec.ImagePath))
                            {
                                <img src="@sec.ImagePath" alt="@sec.Title"
                                     style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid #ecebe6;">
                            }
                            else
                            {
                                <div class="thumb"><i class="bi bi-image"></i></div>
                            }
                        </td>
                        <td style="max-width:0; overflow:hidden;">
                            <div class="strong" style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@sec.Title</div>
                            <div class="desc-cell" style="margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@sec.Body</div>
                        </td>
                        <td class="center text-muted">@sec.DisplayOrder</td>
                        <td class="center">
                            @if (sec.IsActive)
                            {
                                <span class="pill active">Active</span>
                            }
                            else
                            {
                                <span class="pill inactive">Inactive</span>
                            }
                        </td>
                        <td class="right">
                            <div class="row-actions">
                                <a href="/Admin/About?showForm=true&id=@sec.Id" class="icon-btn edit" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="/Admin/AboutSectionDelete" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@sec.Id" />
                                    <button type="submit" class="icon-btn delete" title="Delete"
                                            onclick="return confirm('Delete this section?');">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        @if (showForm)
        {
            <text>
                const form = document.querySelector('.list-card[style*="var(--kpgja-gold)"]');
                if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            </text>
        }
    </script>
}