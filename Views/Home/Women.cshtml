@{ ViewData["Title"] = "Women Empowerment | KPGJA"; }

@section Styles {
<style>

</style>
}

<!-- Top Bar -->


<!-- Page Hero -->
<section class="page-hero">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="section-kicker text-warning">
                    WOMEN EMPOWERMENT
                </span>

                <h1>
                    Creating opportunities for women.
                </h1>

                <p class="lead text-white-50 mt-3">
                    Supporting women through skills development,
                    entrepreneurship, networking and meaningful
                    participation in the gems & jewellery sector.
                </p>

            </div>

        </div>

    </div>
</section>

<!-- Introduction -->
<main>

    <section class="py-5">
        <div class="container">

            <div class="women-intro text-center">

                <span class="section-kicker">
                    OUR COMMITMENT
                </span>

                <h2 class="section-heading mt-2">
                    Empowering women across the industry
                </h2>

                <p class="section-description mt-3">
                    KPGJA aims to create an inclusive environment where
                    women can develop their skills, establish businesses,
                    access markets and participate actively in the gems
                    and jewellery ecosystem.
                </p>

            </div>

            <!-- Core Areas -->
            <div class="row g-4 mt-4">

                <div class="col-md-6 col-lg-3">
                    <div class="women-card">

                        <div class="women-icon">
                            <i class="bi bi-mortarboard"></i>
                        </div>

                        <h4>
                            Skills Training
                        </h4>

                        <p>
                            Promoting technical, creative and entrepreneurial
                            skills through training and capacity-building
                            opportunities.
                        </p>

                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="women-card">

                        <div class="women-icon">
                            <i class="bi bi-shop"></i>
                        </div>

                        <h4>
                            Entrepreneurship
                        </h4>

                        <p>
                            Encouraging women-led businesses and helping
                            entrepreneurs explore new market and business
                            opportunities.
                        </p>

                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="women-card">

                        <div class="women-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <h4>
                            Networking
                        </h4>

                        <p>
                            Connecting women with businesses, professionals,
                            mentors and stakeholders within the industry.
                        </p>

                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="women-card">

                        <div class="women-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <h4>
                            Market Access
                        </h4>

                        <p>
                            Supporting access to exhibitions, markets,
                            industry events and digital opportunities.
                        </p>

                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- Highlight Section -->
    <section class="pb-5">
        <div class="container">

            <div class="women-highlight">

                <div class="row align-items-center g-4">

                    <div class="col-lg-7">

                        <span class="section-kicker text-warning">
                            WOMEN IN GEMS & JEWELLERY
                        </span>

                        <h2 class="mt-2">
                            From skills to sustainable opportunities
                        </h2>

                        <p class="mt-3 mb-0">
                            Women can contribute across many areas of the
                            gems and jewellery value chain, including design,
                            craftsmanship, trading, entrepreneurship,
                            marketing, digital commerce and professional
                            services.
                        </p>

                    </div>

                    <div class="col-lg-5">

                        <div class="row g-4">

                            <div class="col-6">
                                <div class="women-stat">
                                    <strong>
                                        Skills
                                    </strong>
                                    <span>
                                        Training & development
                                    </span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="women-stat">
                                    <strong>
                                        Business
                                    </strong>
                                    <span>
                                        Entrepreneurship
                                    </span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="women-stat">
                                    <strong>
                                        Market
                                    </strong>
                                    <span>
                                        Access & opportunities
                                    </span>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="women-stat">
                                    <strong>
                                        Network
                                    </strong>
                                    <span>
                                        Industry connections
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>

    <!-- Opportunities -->
    <section class="py-5 bg-light">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-6">

                    <span class="section-kicker">
                        OPPORTUNITIES
                    </span>

                    <h2 class="section-heading mt-2">
                        Building participation and inclusion
                    </h2>

                    <p class="section-description mt-3">
                        KPGJA can facilitate opportunities that help women
                        strengthen their professional networks, improve
                        business capabilities and participate in industry
                        activities.
                    </p>

                </div>

                <div class="col-lg-6">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="soft-card p-4 h-100">
                                <i class="bi bi-award fs-2 text-warning"></i>

                                <h5 class="mt-3">
                                    Training Programs
                                </h5>

                                <p class="mb-0 text-muted">
                                    Skills and professional development
                                    initiatives.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="soft-card p-4 h-100">
                                <i class="bi bi-calendar-event fs-2 text-warning"></i>

                                <h5 class="mt-3">
                                    Events & Exhibitions
                                </h5>

                                <p class="mb-0 text-muted">
                                    Opportunities to showcase products
                                    and connect with industry.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="soft-card p-4 h-100">
                                <i class="bi bi-globe2 fs-2 text-warning"></i>

                                <h5 class="mt-3">
                                    Digital Opportunities
                                </h5>

                                <p class="mb-0 text-muted">
                                    Promoting digital visibility and
                                    online business opportunities.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="soft-card p-4 h-100">
                                <i class="bi bi-handshake fs-2 text-warning"></i>

                                <h5 class="mt-3">
                                    Partnerships
                                </h5>

                                <p class="mb-0 text-muted">
                                    Connecting women with relevant
                                    organizations and stakeholders.
                                </p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- CTA -->
    <section class="py-5">

        <div class="container">

            <div class="women-cta text-center">

                <span class="section-kicker">
                    GET INVOLVED
                </span>

                <h2 class="section-heading mt-2">
                    Be part of the KPGJA community
                </h2>

                <p class="section-description mt-3 mx-auto"
                   style="max-width:700px;">

                    Women entrepreneurs, professionals, designers,
                    artisans and other stakeholders can connect with
                    KPGJA and participate in future programs and
                    industry initiatives.

                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">

                    <a href="/Member/Register"
                       class="btn btn-gold btn-lg">

                        <i class="bi bi-person-plus me-1"></i>
                        Become a Member

                    </a>

                    <a href="/Home/Contact"
                       class="btn btn-navy btn-lg">

                        <i class="bi bi-envelope me-1"></i>
                        Contact KPGJA

                    </a>

                </div>

            </div>

        </div>

    </section>

</main>

<!-- Footer -->
