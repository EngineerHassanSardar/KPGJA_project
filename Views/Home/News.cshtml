@model List<Entities.Entities.NewsArticle>
@{
    ViewData["Title"] = "News & Updates | KPGJA";

    // Pick featured: first article with IsFeatured=true; fall back to newest
    var featured = Model?.FirstOrDefault(a => a.IsFeatured)
                ?? Model?.OrderByDescending(a => a.PublishedDate).FirstOrDefault();

    // Everything else goes in the grid (excluding the featured one)
    var rest = Model?.Where(a => a.Id != featured?.Id)
                     .OrderByDescending(a => a.PublishedDate)
                     .ToList()
                ?? new List<Entities.Entities.NewsArticle>();
}


<section class="page-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="section-kicker text-warning">KPGJA NEWS</span>
                <h1>News &amp; Updates</h1>
                <p class="lead text-white-50 mt-3">
                    Stay informed about KPGJA announcements, industry developments,
                    programs, opportunities and association activities.
                </p>
            </div>
        </div>
    </div>
</section>

<main>

    <section class="py-5">
        <div class="container">
            <div class="news-intro text-center">
                <span class="section-kicker">STAY INFORMED</span>
                <h2 class="section-heading">Latest from the KPGJA community</h2>
                <p class="section-description">
                    Follow important association announcements, industry initiatives,
                    training opportunities, networking activities and developments
                    affecting the gems and jewellery sector.
                </p>
            </div>
        </div>
    </section>

    @if (Model == null || !Model.Any())
    {
        <section class="pb-5">
            <div class="container">
                <div class="news-empty">
                    <i class="bi bi-newspaper"></i>
                    <h3>No news yet</h3>
                    <p>Check back soon for announcements and updates from KPGJA.</p>
                </div>
            </div>
        </section>
    }
    else
    {
        @if (featured != null)
        {
            <section class="pb-5">
                <div class="container">
                    <div class="featured-news">
                        <div class="row g-0 align-items-stretch">
                            <div class="col-lg-6">
                                <div class="featured-news-image">
                                    @if (!string.IsNullOrEmpty(featured.ImagePath))
                                    {
                                        <img src="@featured.ImagePath" alt="@featured.Title" loading="lazy">
                                    }
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="featured-news-content">
                                    <div class="featured-label">
                                        <i class="bi bi-star-fill"></i>
                                        @(string.IsNullOrEmpty(featured.Category) ? "Featured Update" : featured.Category)
                                    </div>
                                    <h2>@featured.Title</h2>
                                    <div class="featured-meta">
                                        <span>
                                            <i class="bi bi-calendar3"></i>
                                            @featured.PublishedDate.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>
                                        <span>
                                            <i class="bi bi-building"></i>
                                            @(string.IsNullOrEmpty(featured.Author) ? "KPGJA" : featured.Author)
                                        </span>
                                    </div>
                                    <p>@featured.Summary</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }

        @if (rest.Any())
        {
            <section class="py-5" id="latest-news">
                <div class="container">
                    <div class="news-section-title">
                        <div>
                            <span class="section-kicker">LATEST</span>
                            <h2 class="section-heading">News &amp; Announcements</h2>
                        </div>
                    </div>

                    <div class="row g-4">
                        @foreach (var article in rest)
                        {
                            <div class="col-md-6 col-lg-4">
                                <article class="news-card">
                                    <div class="news-image">
                                        @if (!string.IsNullOrEmpty(article.ImagePath))
                                        {
                                            <img src="@article.ImagePath" alt="@article.Title" loading="lazy">
                                        }
                                        else
                                        {
                                            <i class="bi bi-image placeholder"></i>
                                        }

                                        @if (!string.IsNullOrEmpty(article.Category))
                                        {
                                            <span class="news-category">@article.Category</span>
                                        }

                                        <div class="news-date">
                                            <strong>@article.PublishedDate.Day</strong>
                                            <span>@article.PublishedDate.ToString("MMM")</span>
                                        </div>
                                    </div>

                                    <div class="news-body">
                                        @if (!string.IsNullOrEmpty(article.MetaLabel))
                                        {
                                            <div class="news-meta">
                                                <span>
                                                    <i class="bi @(string.IsNullOrEmpty(article.MetaIcon) ? "bi-info-circle" : article.MetaIcon)"></i>
                                                    @article.MetaLabel
                                                </span>
                                            </div>
                                        }

                                        <h4>@article.Title</h4>
                                        <p>@article.Summary</p>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }

    <!-- ============ 1. STAY CONNECTED (hardcoded) ============ -->
    <section class="pb-5">
        <div class="container">
            <div class="stay-connected-banner">
                <div class="stay-connected-icon">
                    <i class="bi bi-bell"></i>
                </div>
                <div class="stay-connected-body">
                    <h4>Stay connected with KPGJA</h4>
                    <p>Members can stay informed about association announcements, events, programs, opportunities and other important updates through the KPGJA member portal.</p>
                </div>
                <div class="stay-connected-action">
                    <a href="/Member/Login">
                        Member Login <i class="bi bi-box-arrow-in-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ 2. JOIN CTA (hardcoded) ============ -->
    <section class="pb-5">
        <div class="container">
            <div class="join-cta-banner">
                <span class="section-kicker text-warning">JOIN THE COMMUNITY</span>
                <h2>Be part of the KPGJA network</h2>
                <p>
                    Become a member and stay connected with industry activities, networking opportunities,
                    programs, events and association updates.
                </p>
                <div class="join-cta-buttons">
                    <a href="/Home/Membership" class="btn btn-gold btn-lg">
                        <i class="bi bi-person-plus me-1"></i> Become a Member
                    </a>
                    <a href="/Home/Contact" class="btn btn-outline-light btn-lg">
                        Contact KPGJA <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

</main>

@section Styles {
<style>
    /* ============ STAY CONNECTED BANNER ============ */
    .stay-connected-banner {
        display: flex;
        align-items: center;
        gap: 28px;
        background: #f7f5ef;
        border-radius: 20px;
        padding: 32px 40px;
        flex-wrap: wrap;
    }
    .stay-connected-icon {
        width: 60px;
        height: 60px;
        background: #fff;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #d6a84f;
        flex-shrink: 0;
        box-shadow: 0 6px 15px rgba(0,0,0,.05);
    }
    .stay-connected-body {
        flex: 1;
        min-width: 280px;
    }
    .stay-connected-body h4 {
        font-family: "Playfair Display", serif;
        font-size: 24px;
        color: #172033;
        margin-bottom: 8px;
    }
    .stay-connected-body p {
        color: #6c7280;
        font-size: 14px;
        line-height: 1.7;
        margin: 0;
    }
    .stay-connected-action a {
        color: #172033;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: .2s;
    }
    .stay-connected-action a:hover {
        color: #d6a84f;
    }

    /* ============ JOIN CTA BANNER ============ */
    .join-cta-banner {
        background: #172033;
        border-radius: 20px;
        padding: 60px 40px;
        text-align: center;
        color: #fff;
    }
    .join-cta-banner h2 {
        font-family: "Playfair Display", serif;
        font-size: 38px;
        color: #fff;
        margin-top: 14px;
        margin-bottom: 18px;
    }
    .join-cta-banner p {
        color: rgba(255,255,255,.72);
        font-size: 15px;
        line-height: 1.75;
        max-width: 700px;
        margin: 0 auto 28px;
    }
    .join-cta-buttons {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    @@media (max-width: 767px) {
        .stay-connected-banner {
            padding: 24px;
            gap: 18px;
        }
        .stay-connected-body h4 {
            font-size: 20px;
        }
        .join-cta-banner {
            padding: 40px 24px;
        }
        .join-cta-banner h2 {
            font-size: 26px;
        }
    }
</style>
}