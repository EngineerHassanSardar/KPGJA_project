@{ ViewData["Title"] = "Home | Khyber Pakhtunkhwa Gems &amp; Jewellery Association"; }

@section Styles {
<style>

      /* =========================================================
   PRESIDENT'S MESSAGE
========================================================= */

.president-message {
    background: #172033;
    border-radius: 20px;
    overflow: hidden;
    color: #fff;
    box-shadow: 0 12px 35px rgba(0, 0, 0, .08);
}

.president-photo {
    height: 100%;
    min-height: 340px;
    background: #101827;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.president-photo img {
    width: 100%;
    height: 100%;
    min-height: 340px;
    object-fit: cover;
    object-position: center;
}

.president-content {
    padding: 40px 45px;
}

.president-content h3 {
    font-family: "Playfair Display", serif;
    font-size: 28px;
    line-height: 1.35;
    color: #fff;
}

.president-quote {
    padding-left: 20px;
    border-left: 3px solid #d6a84f;
}

.president-quote p {
    color: rgba(255,255,255,.78);
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 0;
}

.president-name h5 {
    color: #fff;
    font-weight: 700;
}

.president-name span {
    color: #d6a84f;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .4px;
}
        .committee-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

            .committee-card img {
                width: 100%;
                height: 340px;
                object-fit: contain;
                object-position: center;
                background: #f3f4f6;
                display: block;
            }

        .committee-info {
            padding: 18px 20px;
        }

            .committee-info h5 {
                margin-bottom: 5px;
                font-weight: 700;
            }

            .committee-info span {
                color: #d6a84f;
                font-size: 13px;
                font-weight: 600;
            }
@@media (max-width: 767px) {

    .president-photo,
    .president-photo img {
        min-height: 280px;
    }

    .president-content {
        padding: 30px 25px;
    }

    .president-content h3 {
        font-size: 24px;
    }

}
    
</style>
}

<!-- =========================================================
     TOP BAR
========================================================= -->




<!-- =========================================================
     HERO SLIDER
========================================================= -->

<section class="hero-section">

    <div id="heroSlider"
         class="carousel slide carousel-fade"
         data-bs-ride="carousel"
         data-bs-interval="6000">


        <!-- Indicators -->

        <div class="carousel-indicators">

            <button type="button"
                    data-bs-target="#heroSlider"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Slide 1">
            </button>

            <button type="button"
                    data-bs-target="#heroSlider"
                    data-bs-slide-to="1"
                    aria-label="Slide 2">
            </button>

            <button type="button"
                    data-bs-target="#heroSlider"
                    data-bs-slide-to="2"
                    aria-label="Slide 3">
            </button>

        </div>


        <div class="carousel-inner">


            <!-- SLIDE 1 -->

            <div class="carousel-item active hero-slide"
                 style="background-image:url('/assets/img/slider/Slide.jpg');">

                <div class="hero-overlay"></div>

                <div class="container">

                    <div class="hero-content">

                        <span class="hero-kicker">
                            KHYBER PAKHTUNKHWA · PAKISTAN
                        </span>

                        <h1>
                            Connecting the
                            <span>Gems & Jewellery</span>
                            Industry
                        </h1>

                        <p>
                            Building stronger connections, developing
                            skills and creating new opportunities for
                            the gems and jewellery sector of
                            Khyber Pakhtunkhwa.
                        </p>

                        <div class="d-flex gap-3 flex-wrap">

                            <a href="/Member/Register"
                               class="btn btn-gold btn-lg">

                                Become a Member

                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                            <a href="/Home/About"
                               class="btn btn-outline-light btn-lg">

                                Discover KPGJA

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- SLIDE 2 -->

            <div class="carousel-item hero-slide"
                 style="background-image:url('/assets/img/slider/Slider1.jpg');">

                <div class="hero-overlay"></div>

                <div class="container">

                    <div class="hero-content">

                        <span class="hero-kicker">
                            SKILLS · TRADE · OPPORTUNITY
                        </span>

                        <h1>
                            From Local Craft
                            <span>to Global Markets</span>
                        </h1>

                        <p>
                            Supporting innovation, skills development,
                            value addition, entrepreneurship and
                            market access.
                        </p>

                        <div class="d-flex gap-3 flex-wrap">

                            <a href="/Home/Industry"
                               class="btn btn-gold btn-lg">

                                Explore Industry

                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                            <a href="/Home/Events"
                               class="btn btn-outline-light btn-lg">

                                View Events

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- SLIDE 3 -->

            <div class="carousel-item hero-slide"
                 style="background-image:url('/assets/img/slider/Slider2.jpg');">

                <div class="hero-overlay"></div>

                <div class="container">

                    <div class="hero-content">

                        <span class="hero-kicker">
                            COMMUNITY · INCLUSION · GROWTH
                        </span>

                        <h1>
                            Empowering People,
                            <span>Growing Communities</span>
                        </h1>

                        <p>
                            Creating opportunities for businesses,
                            entrepreneurs, skilled professionals
                            and women across the sector.
                        </p>

                        <div class="d-flex gap-3 flex-wrap">

                            <a href="/Home/Women"
                               class="btn btn-gold btn-lg">

                                Women Empowerment

                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                            <a href="/Home/Membership"
                               class="btn btn-outline-light btn-lg">

                                Membership

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Previous -->

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#heroSlider"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>

            <span class="visually-hidden">
                Previous
            </span>

        </button>


        <!-- Next -->

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#heroSlider"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>

            <span class="visually-hidden">
                Next
            </span>

        </button>

    </div>

</section>


<!-- =========================================================
     INTRODUCTION
========================================================= -->

<section class="py-5">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="section-kicker">
                    ABOUT KPGJA
                </span>

                <h2 class="section-heading">
                    A shared platform for a
                    stronger industry.
                </h2>

                <p class="lead text-secondary">

                    Khyber Pakhtunkhwa Gems & Jewellery Association
                    brings together businesses, professionals,
                    traders, manufacturers, designers and other
                    stakeholders connected with the gems and
                    jewellery sector.

                </p>

                <p class="text-secondary">

                    The Association aims to support industry
                    development, skills, employment, trade,
                    value addition, entrepreneurship and
                    sustainable growth.

                </p>

                <a href="/Home/About"
                   class="btn btn-dark">

                    Learn About KPGJA

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>


            <div class="col-lg-6">

                <div class="intro-image-wrapper">

                    <img src="/assets/img/about-home.jpg"
                         alt="Gems and jewellery industry"
                         class="img-fluid">

                    <div class="intro-badge">

                        <i class="bi bi-gem"></i>

                        <span>
                            Gems & Jewellery
                            <small>
                                Khyber Pakhtunkhwa
                            </small>
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

