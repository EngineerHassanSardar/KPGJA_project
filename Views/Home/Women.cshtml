@model List<Entities.Entities.WomenFeature>
@{
    ViewData["Title"] = "Women Empowerment | KPGJA";
    var content = ViewBag.Content as Entities.Entities.WomenEmpowermentContent
                  ?? new Entities.Entities.WomenEmpowermentContent();
    var minis = ViewBag.WomenMinis as List<Entities.Entities.WomenMiniFeature> ?? new();
}

<!-- ============ 1. HERO SECTION (DYNAMIC) ============ -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-6">
                <span class="section-kicker">WOMEN EMPOWERMENT</span>
                <h2 class="section-heading mt-2">
                    @(string.IsNullOrEmpty(content.IntroTitle) ? "Creating opportunities for women." : content.IntroTitle)
                </h2>
            
                @if (minis.Any())
                {
                    <div class="row g-3 mt-2">
                        @foreach (var mf in minis)
                        {
                            <div class="col-sm-6">
                                @if (!string.IsNullOrEmpty(mf.Link))
                                {
                                    <a href="@mf.Link" class="mini-feature text-decoration-none">
                                        <i class="bi @mf.IconClass"></i>
                                        <strong>@mf.Label</strong>
                                    </a>
                                }
                                else
                                {
                                    <div class="mini-feature">
                                        <i class="bi @mf.IconClass"></i>
                                        <strong>@mf.Label</strong>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                
            </div>

            <div class="col-lg-6">
                @if (!string.IsNullOrEmpty(content.CoverImagePath))
                {
                    <img src="@content.CoverImagePath" alt="Women Empowerment"
                         style="width:100%; height:auto; min-height:420px; max-height:520px; object-fit:cover; border-radius:20px; box-shadow:0 15px 40px rgba(0,0,0,.10); display:block;">
                }
            </div>

        </div>
    </div>
</section>

<main>

    <!-- ============ 2. OUR COMMITMENT (HARDCODED) ============ -->
    <section class="py-5" style="background:#f7f5ef;">
        <div class="container text-center">
            <span class="section-kicker">OUR COMMITMENT</span>
            <h2 class="section-heading mt-2 mx-auto" style="max-width:900px;">
                Empowering women across the industry
            </h2>
            <p class="section-description mt-3 mx-auto" style="max-width:800px; line-height:1.85;">
                KPGJA aims to create an inclusive environment where women can develop their skills,
                establish businesses, access markets and participate actively in the gems and jewellery ecosystem.
            </p>
        </div>
    </section>

    <!-- ============ 3. CORE AREAS (HARDCODED) ============ -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4">

                <div class="col-md-6 col-lg-3">
                    <div class="objective-card h-100">
                        <div class="objective-icon"><i class="bi bi-mortarboard"></i></div>
                        <h4 style="font-size:20px;">Skills Training</h4>
                        <p>Promoting technical, creative and entrepreneurial skills through training and capacity-building opportunities.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="objective-card h-100">
                        <div class="objective-icon"><i class="bi bi-shop"></i></div>
                        <h4 style="font-size:20px;">Entrepreneurship</h4>
                        <p>Encouraging women-led businesses and helping entrepreneurs explore new market and business opportunities.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="objective-card h-100">
                        <div class="objective-icon"><i class="bi bi-people"></i></div>
                        <h4 style="font-size:20px;">Networking</h4>
                        <p>Connecting women with businesses, professionals, mentors and stakeholders within the industry.</p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="objective-card h-100">
                        <div class="objective-icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <h4 style="font-size:20px;">Market Access</h4>
                        <p>Supporting access to exhibitions, markets, industry events and digital opportunities.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============ 4. WOMEN IN GEMS & JEWELLERY (HARDCODED) ============ -->
    <section class="py-5">
        <div class="container">
            <div class="president-message p-5" style="border-radius:20px;">
                <div class="row align-items-center g-4">
                    <div class="col-lg-7">
                        <span class="section-kicker text-warning">WOMEN IN GEMS &amp; JEWELLERY</span>
                        <h3 style="font-family:'Playfair Display',serif; font-size:32px; line-height:1.3; color:#fff;" class="mt-2 mb-3">
                            From skills to sustainable opportunities
                        </h3>
                        <p style="color:rgba(255,255,255,.72); line-height:1.85; margin-bottom:0;">
                            Women can contribute across many areas of the gems and jewellery value chain, including
                            design, craftsmanship, trading, entrepreneurship, marketing, digital commerce and
                            professional services.
                        </p>
                    </div>

                    <div class="col-lg-5">
                        <div class="row g-3">
                            <div class="col-6">
                                <div style="border-left:3px solid #d6a84f; padding-left:14px;">
                                    <strong style="color:#fff; font-size:20px; display:block;">Skills</strong>
                                    <span style="color:rgba(255,255,255,.65); font-size:13px;">Training &amp; development</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-left:3px solid #d6a84f; padding-left:14px;">
                                    <strong style="color:#fff; font-size:20px; display:block;">Business</strong>
                                    <span style="color:rgba(255,255,255,.65); font-size:13px;">Entrepreneurship</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-left:3px solid #d6a84f; padding-left:14px;">
                                    <strong style="color:#fff; font-size:20px; display:block;">Market</strong>
                                    <span style="color:rgba(255,255,255,.65); font-size:13px;">Access &amp; opportunities</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="border-left:3px solid #d6a84f; padding-left:14px;">
                                    <strong style="color:#fff; font-size:20px; display:block;">Network</strong>
                                    <span style="color:rgba(255,255,255,.65); font-size:13px;">Industry connections</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ 5. OPPORTUNITIES (HARDCODED) ============ -->
    <section class="py-5" style="background:#f7f5ef;">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-5">
                    <span class="section-kicker">OPPORTUNITIES</span>
                    <h2 class="section-heading mt-2">Building participation and inclusion</h2>
                    <p class="text-secondary" style="line-height:1.85;">
                        KPGJA can facilitate opportunities that help women strengthen their professional
                        networks, improve business capabilities and participate in industry activities.
                    </p>
                </div>

                <div class="col-lg-7">
                    <div class="row g-4">

                        <div class="col-md-6">
                            <div style="text-align:center;">
                                <div style="font-size:32px; color:#d6a84f; margin-bottom:12px;">
                                    <i class="bi bi-award"></i>
                                </div>
                                <h5 style="font-family:'Playfair Display',serif;">Training Programs</h5>
                                <p class="text-secondary small mb-0">Skills and professional development initiatives.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div style="text-align:center;">
                                <div style="font-size:32px; color:#d6a84f; margin-bottom:12px;">
                                    <i class="bi bi-calendar-event"></i>
                                </div>
                                <h5 style="font-family:'Playfair Display',serif;">Events &amp; Exhibitions</h5>
                                <p class="text-secondary small mb-0">Opportunities to showcase products and connect with industry.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div style="text-align:center;">
                                <div style="font-size:32px; color:#d6a84f; margin-bottom:12px;">
                                    <i class="bi bi-globe2"></i>
                                </div>
                                <h5 style="font-family:'Playfair Display',serif;">Digital Opportunities</h5>
                                <p class="text-secondary small mb-0">Promoting digital visibility and online business opportunities.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div style="text-align:center;">
                                <div style="font-size:32px; color:#d6a84f; margin-bottom:12px;">
                                    <i class="bi bi-handshake"></i>
                                </div>
                                <h5 style="font-family:'Playfair Display',serif;">Partnerships</h5>
                                <p class="text-secondary small mb-0">Connecting women with relevant organizations and stakeholders.</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============ 6. CTA (HARDCODED) ============ -->
    <section class="py-5">
        <div class="container">
            <div class="women-cta text-center p-5" style="background:#f7f5ef; border-radius:20px;">
                <span class="section-kicker">GET INVOLVED</span>
                <h2 class="section-heading mt-2">Be part of the KPGJA community</h2>
                <p class="section-description mt-3 mx-auto" style="max-width:700px; line-height:1.85;">
                    Women entrepreneurs, professionals, designers, artisans and other stakeholders can connect
                    with KPGJA and participate in future programs and industry initiatives.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
                    <a href="/Home/Membership" class="btn btn-gold btn-lg">
                        <i class="bi bi-person-plus me-1"></i> Become a Member
                    </a>
                    <a href="/Home/Contact" class="btn btn-navy btn-lg">
                        <i class="bi bi-envelope me-1"></i> Contact KPGJA
                    </a>
                </div>
            </div>
        </div>
    </section>

</main>