@{ Layout = "_AdminLayout"; ViewData["Title"] = "Admin Dashboard"; }
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div><h2 class="section-title mb-1">Administrative Dashboard</h2><p class="text-secondary mb-0">Manage KPGJA membership applications and approvals.</p></div>
    <a class="btn btn-gold" href="/Admin/Members"><i class="bi bi-people me-1"></i> Manage Members</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<div class="row g-3">
@foreach (var item in new[] {
    ("Total Applications", (object)ViewBag.TotalApplications, "bi-files"),
    ("Pending Review", (object)ViewBag.Pending, "bi-hourglass-split"),
    ("Approved for Payment", (object)ViewBag.ApprovedForPayment, "bi-credit-card"),
    ("Approved / Active", (object)ViewBag.TotalMembers, "bi-person-check")
})
{
    <div class="col-6 col-lg-3"><div class="soft-card p-4 h-100"><div class="text-secondary">@item.Item1</div><div class="display-6 fw-bold">@item.Item2</div><i class="bi @item.Item3 fs-4 text-secondary"></i></div></div>
}
</div>
<div class="soft-card p-4 mt-4">
    <h5>Approval Workflow</h5>
    <div class="row g-3 mt-1">
        <div class="col-md-3"><strong>1. Application</strong><div class="small text-muted">Applicant submits documents.</div></div>
        <div class="col-md-3"><strong>2. Review</strong><div class="small text-muted">Admin verifies information.</div></div>
        <div class="col-md-3"><strong>3. Payment</strong><div class="small text-muted">Admin records payment.</div></div>
        <div class="col-md-3"><strong>4. Approval</strong><div class="small text-muted">Admin assigns membership number.</div></div>
    </div>
</div>
