@model List<Entities.Entities.EventItem>
@{
    ViewData["Title"] = "Events & Activities | KPGJA";
    var featured = Model?.FirstOrDefault(e => e.IsFeatured)
                ?? Model?.OrderByDescending(e => e.StartDate).FirstOrDefault();
    var rest = Model?.Where(e => e.Id != featured?.Id)
                     .OrderBy(e => e.StartDate)
                     .ToList()
                ?? new List<Entities.Entities.EventItem>();
}



<section class="page-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="section-kicker text-warning">KPGJA EVENTS</span>
                <h1>Events &amp; Activities</h1>
                <p class="lead text-white-50 mt-3">
                    Exhibitions, training programs, networking sessions,
                    seminars and activities that connect and strengthen
                    the gems and jewellery community.
                </p>
            </div>
        </div>
    </div>
</section>

<main>

    <section class="py-5">
        <div class="container">
            <div class="events-intro text-center">
                <span class="section-kicker">CONNECT · LEARN · GROW</span>
                <h2 class="section-heading mt-2">Bringing the industry together</h2>
                <p class="section-description mt-3">
                    KPGJA events provide opportunities for members,
                    businesses, professionals, entrepreneurs and
                    stakeholders to connect, learn and discover
                    new opportunities.
                </p>
            </div>
        </div>
    </section>

    @if (Model == null || !Model.Any())
    {
        <section class="pb-5">
            <div class="container">
                <div class="events-empty">
                    <i class="bi bi-calendar-event"></i>
                    <h3>No events yet</h3>
                    <p>Check back soon for upcoming KPGJA events and activities.</p>
                </div>
            </div>
        </section>
    }
    else
    {
               @if (featured != null)
        {
            <section class="pb-5">
                <div class="container">
                    <div class="event-feature">
                        <div class="d-flex flex-column flex-lg-row align-items-stretch" style="min-height:420px;">

                            <!-- LEFT: Image -->
                            <div style="flex:1 1 50%; min-width:0; overflow:hidden; background:#0d1424;">
                                @if (!string.IsNullOrEmpty(featured.CoverImagePath))
                                {
                                    <img src="@featured.CoverImagePath"
                                         alt="@featured.Title"
                                         style="width:100%; height:100%; min-height:380px; object-fit:cover; display:block;">
                                }
                            </div>

                            <!-- RIGHT: Content -->
                            <div style="flex:1 1 50%; min-width:0; padding:50px 45px; display:flex; flex-direction:column; justify-content:center; color:#fff; overflow:hidden; word-break:break-word; overflow-wrap:anywhere;">
                                <span class="section-kicker text-warning">FEATURED EVENT</span>

                                <h2 class="mt-2" style="font-family:'Playfair Display',serif; font-size:30px; line-height:1.25; color:#fff; margin-bottom:18px; word-break:break-word; overflow-wrap:anywhere;">
                                    @featured.Title
                                </h2>

                                <p class="mt-3" style="color:rgba(255,255,255,.75); line-height:1.8; margin-bottom:20px; word-break:break-word; overflow-wrap:anywhere;">
                                    @featured.Description
                                </p>

                                <div class="d-flex flex-column gap-2" style="color:rgba(255,255,255,.7); font-size:14px;">
                                    @if (!string.IsNullOrEmpty(featured.Location))
                                    {
                                        <div>
                                            <i class="bi bi-geo-alt me-2" style="color:#d6a84f;"></i>
                                            @featured.Location
                                        </div>
                                    }
                                    <div>
                                        <i class="bi bi-calendar-event me-2" style="color:#d6a84f;"></i>
                                        @featured.StartDate.ToString("dd MMM yyyy")
                                        @if (featured.EndDate.HasValue && featured.EndDate.Value != featured.StartDate)
                                        {
                                            <span> – @featured.EndDate.Value.ToString("dd MMM yyyy")</span>
                                        }
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>
        }
        @if (rest.Any())
        {
            <section class="py-5 bg-light">
                <div class="container">
                    <div class="event-section-title">
                        <div>
                            <span class="section-kicker">UPCOMING</span>
                            <h2 class="section-heading mt-2">Upcoming Events</h2>
                        </div>
                    </div>

                    <div class="row g-4">
                        @foreach (var ev in rest)
                        {
                            <div class="col-md-6">
                                <div class="event-card">
                                    <div class="event-image">
                                        @if (!string.IsNullOrEmpty(ev.CoverImagePath))
                                        {
                                          <img src="@ev.CoverImagePath" alt="@ev.Title" loading="lazy"
     style="width:100%; height:100%; object-fit:cover; object-position:center;">
                                        }
                                        else
                                        {
                                            <i class="bi bi-calendar-event placeholder"></i>
                                        }

                                        @if (!string.IsNullOrEmpty(ev.Category))
                                        {
                                            <span class="event-category">@ev.Category</span>
                                        }

                                        <div class="event-date">
                                            <strong>@ev.StartDate.Day</strong>
                                            <span>@ev.StartDate.ToString("MMM")</span>
                                        </div>
                                    </div>

                                    <div class="event-body">
                                        <h4>@ev.Title</h4>
                                        <div class="event-meta">
                                            @if (!string.IsNullOrEmpty(ev.Location))
                                            {
                                                <span><i class="bi bi-geo-alt"></i> @ev.Location</span>
                                            }
                                            <span><i class="bi bi-calendar"></i> @ev.StartDate.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <p>@ev.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        }
    }

    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-kicker">ACTIVITIES</span>
                <h2 class="section-heading mt-2">What happens through KPGJA</h2>
                <p class="section-description mx-auto mt-3" style="max-width:700px;">
                    Events can support knowledge sharing, market access,
                    networking and professional development throughout
                    the industry.
                </p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="activity-card">
                        <div class="activity-icon"><i class="bi bi-shop-window"></i></div>
                        <h5>Exhibitions</h5>
                        <p>Product showcases, exhibitions and opportunities to connect businesses with markets.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="activity-card">
                        <div class="activity-icon"><i class="bi bi-mortarboard"></i></div>
                        <h5>Training</h5>
                        <p>Workshops, seminars and skills development activities for industry participants.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="activity-card">
                        <div class="activity-icon"><i class="bi bi-people"></i></div>
                        <h5>Networking</h5>
                        <p>Bringing members, businesses and stakeholders together for meaningful connections.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="activity-card">
                        <div class="activity-icon"><i class="bi bi-lightbulb"></i></div>
                        <h5>Seminars</h5>
                        <p>Knowledge-sharing sessions covering industry trends, opportunities and business development.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-5">
        <div class="container">
            <div class="events-cta text-center">
                <span class="section-kicker">STAY CONNECTED</span>
                <h2 class="section-heading mt-2">Don't miss upcoming KPGJA activities</h2>
                <p class="section-description mx-auto mt-3" style="max-width:700px;">
                    Become a member to stay connected with association
                    activities, industry opportunities, events and
                    future programs.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
                    <a href="/Member/Register" class="btn btn-gold btn-lg">
                        <i class="bi bi-person-plus me-1"></i> Become a Member
                    </a>
                    <a href="/Home/Contact" class="btn btn-navy btn-lg">
                        <i class="bi bi-envelope me-1"></i> Contact KPGJA
                    </a>
                </div>
            </div>
        </div>
    </section>

</main>