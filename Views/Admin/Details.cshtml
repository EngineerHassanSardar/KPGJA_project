@model Entities.Entities.MembershipApplication


@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Review Application";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success d-flex align-items-center gap-2" style="border-radius:12px;">
        <i class="bi bi-check-circle-fill"></i> @success
    </div>
}

<div class="row g-4">
    <!-- LEFT COLUMN -->
    <div class="col-lg-8">

        <!-- Applicant Details -->
        <div class="soft-card p-4">
            <div class="card-head">
                <i class="bi bi-person-vcard"></i>
                <h5>Applicant &amp; Business Details</h5>
            </div>

            <div class="row g-3">
                <div class="col-md-6"><div class="small text-muted">Full Name</div><div class="fw-semibold">@Model.FullName</div></div>
                <div class="col-md-6"><div class="small text-muted">Father / Husband</div><div class="fw-semibold">@Model.FatherHusbandName</div></div>
                <div class="col-md-6"><div class="small text-muted">CNIC</div><div class="fw-semibold">@Model.Cnic</div></div>
                <div class="col-md-6"><div class="small text-muted">Business</div><div class="fw-semibold">@Model.BusinessName</div></div>
                <div class="col-md-6"><div class="small text-muted">Designation</div><div class="fw-semibold">@Model.Designation</div></div>
                <div class="col-md-6"><div class="small text-muted">Nature of Business</div><div class="fw-semibold">@Model.NatureOfBusiness</div></div>
                <div class="col-md-6"><div class="small text-muted">Mobile</div><div class="fw-semibold">@Model.MobileNo</div></div>
                <div class="col-md-6"><div class="small text-muted">Email</div><div class="fw-semibold">@Model.Email</div></div>
                <div class="col-md-6"><div class="small text-muted">City / District</div><div class="fw-semibold">@Model.CityDistrict</div></div>
                <div class="col-md-6"><div class="small text-muted">Membership Category</div><div class="fw-semibold">@Model.MembershipCategory</div></div>
                <div class="col-12"><div class="small text-muted">Business Address</div><div class="fw-semibold">@Model.BusinessAddress</div></div>
                <div class="col-12"><div class="small text-muted">Business Types</div><div class="fw-semibold">@Model.BusinessTypes</div></div>
            </div>
        </div>

        <!-- Documents -->
        <div class="soft-card p-4 mt-4">
            <div class="card-head">
                <i class="bi bi-folder2-open"></i>
                <h5>Uploaded Documents</h5>
            </div>

            <div class="row g-2">
                @foreach (var d in new[] {
                    ("CNIC","cnic",Model.CnicDocumentPath),
                    ("Passport Photo","photo",Model.PassportPhotoPath),
                    ("Business Registration","business",Model.BusinessRegistrationDocumentPath),
                    ("Fee Receipt","fee",Model.FeeReceiptPath),
                    ("Bank Deposit Slip","bank",Model.BankDepositSlipPath),
                    ("Recommendation","recommendation",Model.RecommendationDocumentPath)
                })
                {
                    <div class="col-md-6">
                        @if (!string.IsNullOrWhiteSpace(d.Item3))
                        {
                            <a class="btn btn-outline-secondary btn-sm w-100 text-start d-flex align-items-center gap-2"
                               style="border-radius:10px;padding:10px 14px;font-weight:500;"
                               target="_blank" href="/Admin/DownloadDocument/@Model.Id?type=@d.Item2">
                                <i class="bi bi-file-earmark-arrow-down"></i> @d.Item1
                            </a>
                        }
                        else
                        {
                            <div class="btn btn-light btn-sm w-100 text-start d-flex align-items-center gap-2 text-muted disabled"
                                 style="border-radius:10px;padding:10px 14px;">
                                <i class="bi bi-file-earmark-x"></i> @d.Item1 <span class="ms-auto small">Not uploaded</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-lg-4">
        <div class="soft-card p-4" style="position:sticky;top:92px;">
            <div class="card-head">
                <i class="bi bi-shield-check"></i>
                <h5>Approval Panel</h5>
            </div>

            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id">

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Status</label>
                    <select class="form-select" name="Status" style="border-radius:10px;height:42px;">
                        @foreach (var status in new[] { "Pending Review","Approved for Payment","Payment Submitted","Payment Verified","Approved","Active Member","Rejected" })
                        {
                            <option value="@status" selected="@(Model.Status == status ? "selected" : null)">@status</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Membership No.</label>
                    <input class="form-control" name="MembershipNo" value="@Model.MembershipNo" style="border-radius:10px;height:42px;">
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Fee Received (PKR)</label>
                    <input class="form-control" type="number" step="0.01" name="FeeReceived" value="@Model.FeeReceived" style="border-radius:10px;height:42px;">
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Payment Reference</label>
                    <input class="form-control" name="PaymentReference" value="@Model.PaymentReference" style="border-radius:10px;height:42px;">
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Admin Remarks</label>
                    <textarea class="form-control" name="AdminRemarks" rows="4" style="border-radius:10px;">@Model.AdminRemarks</textarea>
                </div>

                <button class="btn btn-gold w-100">
                    <i class="bi bi-check2-circle me-1"></i> Save Approval
                </button>
            </form>
        </div>
    </div>
</div>