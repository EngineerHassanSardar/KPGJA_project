@{
    var title = ViewData["Title"] as string ?? "KPGJA";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Khyber Pakhtunkhwa Gems & Jewellery Association">

    <title>@title | KPGJA</title>

    <!-- Browser Tab Logo / Favicon -->
    <link rel="icon" type="image/png" href="/assets/img/logo.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <link href="/assets/css/style.css" rel="stylesheet">

    @RenderSection("Styles", required: false)
</head>
<body>
<div class="topbar">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div><i class="bi bi-building me-1"></i> Government of Khyber Pakhtunkhwa</div>
            <div><i class="bi bi-geo-alt me-1"></i> Peshawar, Khyber Pakhtunkhwa, Pakistan</div>
        </div>
    </div>
</div>

<header class="brand-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center gap-4">
            <a href="/" class="brand d-flex align-items-center gap-3 text-decoration-none">
                <div class="brand-logo-wrapper"><img src="/assets/img/logo.png" alt="KPGJA Logo" class="brand-logo"></div>
                <div>
                    <div class="brand-title">Khyber Pakhtunkhwa<br>Gems & Jewellery Association</div>
                    <div class="brand-short">KPGJA</div>
                </div>
            </a>
            <div class="brand-office text-end d-none d-lg-block">
                <div class="small text-uppercase text-muted">Head Office</div>
                <strong>Hamza Market, Namak Mandi</strong>
                <div class="small text-muted">Peshawar, Khyber Pakhtunkhwa</div>
            </div>
        </div>
    </div>
</header>

<nav class="navbar navbar-expand-lg navbar-dark main-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand d-lg-none fw-bold" href="/">KPGJA</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/About">About Us</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Executive">Executive Committee</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Women">Women Empowerment</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Industry">Industry</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Events">Events</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/News">News & Updates</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Contact">Contact</a></li>
            </ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Member/Dashboard" class="btn btn-outline-light me-2"><i class="bi bi-person me-1"></i> My Portal</a>
            }
            else
            {
                <a href="/Member/Register" class="btn btn-gold"><i class="bi bi-person-plus me-1"></i> Become a Member</a>
            }
        </div>
    </div>
</nav>

@RenderBody()

<footer class="footer">
  <div class="container py-5">
    <div class="row g-5">
      <div class="col-lg-5">
        <h5 class="text-white">Khyber Pakhtunkhwa<br>Gems & Jewellery Association</h5>
        <p>Uniting stakeholders, promoting skills, employment, trade, digital opportunities and sustainable development across KP's gems and jewellery sector.</p>
      </div>
      <div class="col-6 col-lg-2">
        <h6 class="text-white">Quick Links</h6>
        <a href="/">Home</a><a href="/Home/About">About Us</a><a href="/Home/Membership">Membership</a><a href="/Home/Events">Events</a>
      </div>
      <div class="col-6 col-lg-2">
        <h6 class="text-white">Resources</h6>
        <a href="/Home/News">News</a><a href="/Home/Industry">Industry</a><a href="/Home/Women">Women Empowerment</a><a href="/Home/Contact">Contact</a>
      </div>
      <div class="col-lg-3">
        <h6 class="text-white">Follow Us</h6>
        <div class="social-links"><a href="#"><i class="bi bi-facebook"></i></a><a href="#"><i class="bi bi-linkedin"></i></a><a href="#"><i class="bi bi-youtube"></i></a></div>
      </div>
    </div>
  </div>
  <div class="footer-bottom"><div class="container"><div class="d-flex justify-content-between flex-wrap gap-2"><span>© <span data-year></span> KPGJA. All Rights Reserved.</span><span>Unity · Skill · Service · Employment · Development</span></div></div></div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/assets/js/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
