@{ ViewData["Title"] = "Events &amp; Activities | KPGJA"; }

@section Styles {
<style>

        .events-intro {
            max-width: 820px;
            margin: 0 auto;
        }

        .event-card {
            background: #fff;
            border: 1px solid #e9eaed;
            border-radius: 20px;
            overflow: hidden;
            height: 100%;
            transition: .25s ease;
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,.08);
        }

        .event-image {
            position: relative;
            height: 230px;
            overflow: hidden;
            background: #172033;
        }

        .event-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

        .event-card:hover .event-image img {
            transform: scale(1.06);
        }

        .event-category {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 2;
            background: #d6a84f;
            color: #172033;
            padding: 7px 12px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .event-date {
            position: absolute;
            right: 15px;
            bottom: 15px;
            z-index: 2;
            width: 58px;
            height: 62px;
            background: #fff;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

        .event-date strong {
            font-size: 20px;
            line-height: 1;
            color: #172033;
        }

        .event-date span {
            font-size: 10px;
            text-transform: uppercase;
            color: #b88a2d;
            font-weight: 700;
            margin-top: 4px;
        }

        .event-body {
            padding: 25px;
        }

        .event-body h4 {
            font-family: "Playfair Display", serif;
            color: #172033;
            margin-bottom: 10px;
        }

        .event-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            color: #6c7280;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .event-meta i {
            color: #b88a2d;
            margin-right: 5px;
        }

        .event-body p {
            color: #6c7280;
            font-size: 14px;
        }

        .event-section-title {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .event-section-title h2 {
            margin-bottom: 0;
        }

        .event-feature {
            background: #172033;
            border-radius: 22px;
            overflow: hidden;
            color: #fff;
        }

        .event-feature-image {
            min-height: 350px;
            height: 100%;
        }

        .event-feature-image img {
            width: 100%;
            height: 100%;
            min-height: 350px;
            object-fit: cover;
        }

        .event-feature-content {
            padding: 45px;
        }

        .event-feature-content h2 {
            font-family: "Playfair Display", serif;
        }

        .event-feature-content p {
            color: rgba(255,255,255,.72);
        }

        .event-feature-meta {
            color: rgba(255,255,255,.7);
        }

        .event-feature-meta i {
            color: #d6a84f;
        }

        .activity-card {
            border: 1px solid #e9eaed;
            border-radius: 18px;
            padding: 25px;
            height: 100%;
            background: #fff;
        }

        .activity-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: #f5f1e7;
            color: #b88a2d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 18px;
        }

        .activity-card h5 {
            font-family: "Playfair Display", serif;
            color: #172033;
        }

        .activity-card p {
            color: #6c7280;
            margin-bottom: 0;
            font-size: 14px;
        }

        .events-cta {
            background: #f7f5ef;
            border-radius: 22px;
            padding: 45px;
        }

        @@media (max-width: 767px) {
            .event-feature-content {
                padding: 30px;
            }

            .event-feature-image,
            .event-feature-image img {
                min-height: 250px;
            }

            .events-cta {
                padding: 30px;
            }
        }
    
</style>
}

<!-- Top Bar -->


<!-- Hero -->
<section class="page-hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="section-kicker text-warning">
                    KPGJA EVENTS
                </span>

                <h1>
                    Events & Activities
                </h1>

                <p class="lead text-white-50 mt-3">
                    Exhibitions, training programs, networking sessions,
                    seminars and activities that connect and strengthen
                    the gems and jewellery community.
                </p>

            </div>

        </div>

    </div>

</section>

<main>

    <!-- Introduction -->
    <section class="py-5">

        <div class="container">

            <div class="events-intro text-center">

                <span class="section-kicker">
                    CONNECT · LEARN · GROW
                </span>

                <h2 class="section-heading mt-2">
                    Bringing the industry together
                </h2>

                <p class="section-description mt-3">
                    KPGJA events provide opportunities for members,
                    businesses, professionals, entrepreneurs and
                    stakeholders to connect, learn and discover
                    new opportunities.
                </p>

            </div>

        </div>

    </section>

    <!-- Featured Event -->
    <section class="pb-5">

        <div class="container">

            <div class="event-feature">

                <div class="row g-0 align-items-stretch">

                    <div class="col-lg-6">

                        <div class="event-feature-image">

                            <img src="/assets/img/events/exhibition.jpg"
                                 alt="Gem and Jewellery Exhibition">

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="event-feature-content h-100 d-flex flex-column justify-content-center">

                            <span class="section-kicker text-warning">
                                FEATURED EVENT
                            </span>

                            <h2 class="mt-2">
                                Gem & Jewellery Exhibition
                            </h2>

                            <p class="mt-3">
                                An opportunity for businesses, designers,
                                traders and industry professionals to
                                showcase products, build connections and
                                explore new market opportunities.
                            </p>

                            <div class="event-feature-meta mt-3">

                                <div class="mb-2">
                                    <i class="bi bi-geo-alt me-2"></i>
                                    Peshawar, Khyber Pakhtunkhwa
                                </div>

                                <div class="mb-2">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    Date to be announced
                                </div>

                                <div>
                                    <i class="bi bi-clock me-2"></i>
                                    Event schedule to be announced
                                </div>

                            </div>

                            <div class="mt-4">

                                <a href="/Home/Contact"
                                   class="btn btn-gold">

                                    <i class="bi bi-info-circle me-1"></i>
                                    Event Information

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Upcoming Events -->
