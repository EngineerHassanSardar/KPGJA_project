@model RegisterViewModel
@{ ViewData["Title"] = "Member Registration"; }

<section class="page-hero">
    <div class="container">
        <span class="section-kicker text-warning">JOIN KPGJA</span>
        <h1>Member Registration</h1>
        <p class="lead text-white-50 mb-0">
            Complete the membership application and submit the required information and documents online.
        </p>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-11">

                <div class="registration-card">
                    <div class="registration-header">
                        <h3>Membership Registration Form</h3>
                        <p>Please complete this form carefully and provide the required documents.</p>
                    </div>

                    <div class="registration-body">
                        <form asp-action="Register" asp-controller="Member" method="post"
                              id="membershipForm" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                            <!-- 1. APPLICANT -->
                            <div class="form-section-title">
                                <span class="form-section-number">01</span>
                                <h4>Applicant / Business Details</h4>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Business / Firm Name <span class="required">*</span></label>
                                    <input type="text" name="businessName" class="form-control" placeholder="Enter business or firm name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Applicant Full Name <span class="required">*</span></label>
                                    <input type="text" name="fullName" class="form-control" placeholder="Enter full name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Father's / Husband's Name <span class="required">*</span></label>
                                    <input type="text" name="fatherHusbandName" class="form-control" placeholder="Enter father's / husband's name" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">CNIC Number <span class="required">*</span></label>
                                    <input type="text" name="cnic" class="form-control" placeholder="XXXXX-XXXXXXX-X" maxlength="15" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Designation / Title in Firm</label>
                                    <input type="text" name="designation" class="form-control" placeholder="e.g. Owner, Director, Partner">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Years in Gems &amp; Jewellery Business</label>
                                    <input type="number" name="yearsInBusiness" class="form-control" min="0" placeholder="Enter number of years">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Nature of Business <span class="required">*</span></label>
                                    <textarea name="natureOfBusiness" class="form-control" rows="2" placeholder="Describe your gems and jewellery business activities" required></textarea>
                                </div>
                            </div>

                            <!-- 2. CONTACT -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">02</span>
                                <h4>Contact Information</h4>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Mobile Number <span class="required">*</span></label>
                                    <input type="tel" name="mobileNo" class="form-control" placeholder="03XX-XXXXXXX" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Landline Number</label>
                                    <input type="tel" name="landlineNo" class="form-control" placeholder="091-XXXXXXX">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email Address <span class="required">*</span></label>
                                    <input type="email" name="email" class="form-control" placeholder="example@email.com" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Website <span class="text-muted">(if any)</span></label>
                                    <input type="url" name="website" class="form-control" placeholder="https://example.com">
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Business Address <span class="required">*</span></label>
                                    <textarea name="businessAddress" class="form-control" rows="2" placeholder="Enter complete business address" required></textarea>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">City / District <span class="required">*</span></label>
                                    <input type="text" name="cityDistrict" class="form-control" placeholder="e.g. Peshawar" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Postal Code</label>
                                    <input type="text" name="postalCode" class="form-control" placeholder="Postal Code">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Password <span class="required">*</span></label>
                                    <input type="password" name="password" class="form-control" placeholder="Create password" minlength="6" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Confirm Password <span class="required">*</span></label>
                                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm password" minlength="6" required>
                                </div>
                            </div>

                            <!-- 3. CATEGORY -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">03</span>
                                <h4>Category of Membership</h4>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="membership-category-option">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="membershipCategory" id="ordinaryMember" value="Ordinary Member" required>
                                            <label class="form-check-label" for="ordinaryMember">
                                                <span class="membership-category-name">Ordinary Member</span><br>
                                                <span class="membership-category-fee">PKR 1,000</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="membership-category-option">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="membershipCategory" id="associateMember" value="Associate Member">
                                            <label class="form-check-label" for="associateMember">
                                                <span class="membership-category-name">Associate Member</span><br>
                                                <span class="membership-category-fee">PKR 2,500</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="membership-category-option">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="membershipCategory" id="honoraryMember" value="Honorary Member">
                                            <label class="form-check-label" for="honoraryMember">
                                                <span class="membership-category-name">Honorary Member</span><br>
                                                <span class="membership-category-fee">PKR 3,500</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="small text-secondary mt-2 mb-0" style="font-size:11.5px;">
                                The membership fee structure is applicable for the time being and may be revised by the Association in the future.
                            </p>

                            <div class="mt-3">
                                <label class="form-label">Nature / Category of Business <span class="required">*</span></label>
                                <div class="row g-2">
                                    @foreach (var bt in new[] { "Trader / Dealer", "Miner", "Cutter / Polisher (Lapidary)", "Jeweller", "Manufacturer", "Exporter" })
                                    {
                                        <div class="col-md-4">
                                            <div class="business-type-option">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="businessType" value="@bt" id="bt-@bt.Replace(" ", "").Replace("/", "")">
                                                    <label class="form-check-label" for="bt-@bt.Replace(" ", "").Replace("/", "")">@bt</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- 4. BUSINESS REGISTRATION -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">04</span>
                                <h4>Business Registration Details</h4>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">NTN / STRN <span class="text-muted">(if applicable)</span></label>
                                    <input type="text" name="ntnStrn" class="form-control" placeholder="Enter NTN / STRN">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Mining / Trading Licence No. <span class="text-muted">(if applicable)</span></label>
                                    <input type="text" name="licenceNo" class="form-control" placeholder="Enter licence number">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Chamber / Association Membership <span class="text-muted">(if any)</span></label>
                                    <input type="text" name="associationMembership" class="form-control" placeholder="Enter chamber / association name">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">KP Registration No.</label>
                                    <input type="text" name="kpRegistrationNo" class="form-control" placeholder="Enter KP registration number">
                                </div>
                            </div>

                            <!-- 5. DOCUMENTS -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">05</span>
                                <h4>Documents Enclosed</h4>
                            </div>

                            <div class="document-box">
                                @foreach (var doc in new[] {
                                    ("cnicDocument", "Copy of CNIC", ".pdf,.jpg,.jpeg,.png", true),
                                    ("passportPhoto", "Passport-size Photograph", ".jpg,.jpeg,.png", false),
                                    ("businessRegistrationDocument", "Business Registration / Licence", ".pdf,.jpg,.jpeg,.png", false),
                                    ("feeReceipt", "Membership Fee Receipt", ".pdf,.jpg,.jpeg,.png", false),
                                    ("bankDepositSlip", "Bank Deposit Slip", ".pdf,.jpg,.jpeg,.png", false),
                                    ("recommendationDocument", "Recommendation of an Existing Member (if required)", ".pdf,.jpg,.jpeg,.png", false)
                                })
                                {
                                    <div class="document-item">
                                        <div class="row align-items-center g-2">
                                            <div class="col-lg-5">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="documentsEnclosed" value="@doc.Item2" id="doc-@doc.Item1" required="@(doc.Item4 ? "required" : null)">
                                                    <label class="form-check-label" for="doc-@doc.Item1">@doc.Item2</label>
                                                </div>
                                            </div>
                                            <div class="col-lg-7">
                                                <input type="file" name="@doc.Item1" class="form-control" accept="@doc.Item3">
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- 6. DECLARATION -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">06</span>
                                <h4>Declaration</h4>
                            </div>

                            <div class="declaration-box">
                                <p>
                                    I hereby declare that the information provided above is true and correct to the best of my knowledge. I agree to abide by the Constitution, rules, and code of conduct of the KP Gems &amp; Jewellery Association, and understand that any false statement may lead to rejection or cancellation of membership.
                                </p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="declarationAgreement" name="declarationAgreement" required>
                                    <label class="form-check-label" for="declarationAgreement" style="font-size:12.5px;">
                                        I have read and agree to the above declaration. <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 7. FEE -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">07</span>
                                <h4>Non-Refundable Membership Fee</h4>
                            </div>

                            <div class="declaration-box">
                                <p>
                                    I understand and agree that once the membership fee / amount has been paid, the amount shall be non-refundable under any circumstances, including withdrawal of the application, change of mind, rejection, cancellation, or discontinuation of membership, subject to the Association's applicable rules and decisions.
                                </p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="feeAgreement" name="feeAgreement" required>
                                    <label class="form-check-label" for="feeAgreement" style="font-size:12.5px;">
                                        I understand and agree to the non-refundable membership fee terms. <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 8. UNDERTAKING -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">08</span>
                                <h4>Declaration &amp; Undertaking</h4>
                            </div>

                            <div class="declaration-box">
                                <p>I hereby declare and affirm that I am applying for membership of the KP Gems &amp; Jewellery Association under the membership category selected by me in this form.</p>
                                <p>I undertake to abide by the Constitution, rules, regulations, policies and code of conduct of the Association, as amended from time to time, and I shall not knowingly act against the interests, rules or lawful decisions of the Association.</p>
                                <p>I further undertake that I shall conduct myself in accordance with the rules and objectives of the Association and shall not engage in any activity that violates the Association's Constitution, rules, code of conduct or applicable law.</p>
                                <p>I understand that violation of these undertakings may result in disciplinary action, including suspension or cancellation of membership, in accordance with the Association's applicable procedures.</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="undertakingAgreement" name="undertakingAgreement" required>
                                    <label class="form-check-label" for="undertakingAgreement" style="font-size:12.5px;">
                                        I have read, understood and agree to the above undertaking. <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 9. AUTHENTICITY -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">09</span>
                                <h4>Authenticity of Documents &amp; Information</h4>
                            </div>

                            <div class="declaration-box">
                                <p>I hereby declare that all information provided in this membership application is true, accurate and complete to the best of my knowledge.</p>
                                <p>I further declare that all documents, certificates, licences, identification documents and other records submitted, uploaded or attached with this application are genuine, valid and lawfully belong to me / my business, as applicable.</p>
                                <p>Where a copy or scanned copy is submitted, I confirm that it is a true and accurate copy of the original document and has not been forged, altered or misrepresented.</p>
                                <p>I understand that if any information or document is found to be false, forged, altered or misleading, the Association may reject my application or take appropriate action regarding my membership in accordance with its rules.</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="authenticityAgreement" name="authenticityAgreement" required>
                                    <label class="form-check-label" for="authenticityAgreement" style="font-size:12.5px;">
                                        I confirm the authenticity of the information and documents submitted. <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                            <!-- 10. FINAL -->
                            <div class="form-section-title mt-5">
                                <span class="form-section-number">10</span>
                                <h4>Applicant's Final Confirmation</h4>
                            </div>

                            <div class="declaration-box">
                                <p>By submitting this application, I confirm that I have read, understood and accepted the above declaration, undertaking, fee terms and document-authenticity requirements, and I voluntarily submit this application for membership.</p>

                                <div class="row g-3 mt-1">
                                    <div class="col-md-6">
                                        <label class="form-label">Applicant Full Name</label>
                                        <input type="text" name="confirmationFullName" class="form-control" placeholder="Enter full name" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">CNIC Number</label>
                                        <input type="text" name="confirmationCnic" class="form-control" placeholder="XXXXX-XXXXXXX-X" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Signature</label>
                                        <input type="text" name="signature" class="form-control" placeholder="Type your full name as signature" required>
                                    </div>
                                </div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input" type="checkbox" id="finalConfirmation" name="finalConfirmation" required>
                                    <label class="form-check-label" for="finalConfirmation" style="font-size:12.5px;">
                                        I confirm that all information provided in this application is correct and complete. <span class="required">*</span>
                                    </label>
                                </div>
                            </div>

                            <div class="alert alert-warning mt-4 py-2" style="font-size:12px;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                <strong>Important:</strong> Submission of this application does not automatically guarantee membership. The application will be reviewed and processed by the Association according to its membership requirements.
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                                <a href="/Member/Login" class="btn btn-outline-secondary">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Already a Member? Login
                                </a>
                                <button type="submit" class="btn btn-gold">
                                    <i class="bi bi-send me-1"></i> Submit Membership Application
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>