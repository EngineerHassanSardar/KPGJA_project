                    </p>

                </div>

            </div>


            <!-- 05 -->

            <div class="col-md-6 col-lg-4">

                <div class="industry-card h-100">

                    <div class="industry-icon">

                        <i class="bi bi-globe2"></i>

                    </div>


                    <h5>

                        Market Opportunities

                    </h5>


                    <p>

                        Access information about relevant industry
