@model AdminMemberListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Applications";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-secondary mb-0">Manage all membership applications.</p>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-dark btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button class="btn btn-outline-dark btn-sm" onclick="alert('Export to Excel (UI only)')">
            <i class="bi bi-file-earmark-excel me-1"></i> Export
        </button>
    </div>
</div>
<!-- Filter Bar -->
<form method="get" class="filter-bar mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0" style="border-radius:10px 0 0 10px;border-color:#ecebe6;">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input asp-for="Search" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" placeholder="Search by name, business, email or CNIC">
            </div>
        </div>
        <div class="col-md-4">
            <select asp-for="Status" class="form-select">
                <option value="">All Statuses</option>
                <option>Pending Review</option>
                <option>Approved for Payment</option>
                <option>Payment Submitted</option>
                <option>Payment Verified</option>
                <option>Approved</option>
                <option>Active Member</option>
                <option>Rejected</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-dark w-100" style="height:42px;border-radius:10px;font-weight:600;">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
        </div>
    </div>
</form>

<!-- Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Business</th>
                    <th>Category</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Members.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                            <span class="text-muted">No applications found.</span>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model.Members)
                    {
                        var statusClass = m.Status switch
                        {
                            "Pending Review"        => "status-pending",
                            "Approved for Payment"  => "status-approved-pay",
                            "Payment Submitted"     => "status-payment-sub",
                            "Payment Verified"      => "status-payment-ver",
                            "Approved"              => "status-approved",
                            "Active Member"         => "status-active",
                            "Rejected"              => "status-rejected",
                            _ => "status-pending"
                        };
                        var initials = string.Concat(
                            m.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2).Select(s => s[0])
                        ).ToUpper();

                        <tr>
                            <td>
                                <div class="member-cell">
                                    <div class="member-avatar">@initials</div>
                                    <div>
                                        <div class="member-name">@m.FullName</div>
                                        <div class="member-sub">@m.Cnic</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="member-name">@m.BusinessName</div>
                                <div class="member-sub">@m.Email</div>
                            </td>
                            <td>@m.MembershipCategory</td>
                            <td class="fw-semibold">PKR @m.MembershipFee.ToString("N0")</td>
                            <td><span class="status-badge @statusClass">@m.Status</span></td>
                            <td class="text-muted">@m.ApplicationDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-dark" style="border-radius:8px;font-weight:500;" href="/Admin/Details/@m.Id">
                                    Review <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>