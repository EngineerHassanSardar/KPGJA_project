@model List<Entities.Entities.CommitteeMember>
@{
    ViewData["Title"] = "Executive Committee | KPGJA";
    var members = Model ?? new();
}

<!-- ============ HERO ============ -->
<section class="page-hero">
    <div class="container">
        <span class="section-kicker text-warning">LEADERSHIP</span>
        <h1>Executive Committee</h1>
        <p class="lead text-white-50 mb-0">
            Meet the leadership representing the Khyber Pakhtunkhwa Gems &amp; Jewellery Association.
        </p>
    </div>
</section>

<main>

    <section class="py-5">
        <div class="container">

            @if (members.Any())
            {
                <div class="row g-4 justify-content-center">
                    @{
                        int n = 0;
                    }
                    @foreach (var m in members.OrderBy(x => x.DisplayOrder))
                    {
                        n++;
                        var num = n.ToString("D2"); // 01, 02, 03...

                        <div class="col-sm-6 col-md-4 col-lg-3">
                            <div class="committee-card-pro">

                                <!-- NUMBER BADGE -->
                                <div class="committee-number">@num</div>

                                <!-- PHOTO -->
                                <div class="committee-photo">
                                    @if (!string.IsNullOrEmpty(m.PhotoPath))
                                    {
                                        <img src="@m.PhotoPath" alt="@m.FullName">
                                    }
                                    else
                                    {
                                        <div class="committee-photo-placeholder">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    }
                                </div>

                                <!-- NAME + DIVIDER + DESIGNATION -->
                                <div class="committee-meta">
                                    <h4>@m.FullName</h4>
                                    <div class="committee-divider"></div>
                                    <span>@m.Designation</span>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted">No committee members published yet.</p>
                </div>
            }

        </div>
    </section>

</main>

@section Styles {
<style>
    /* ============ COMMITTEE CARD — PROFESSIONAL ============ */
    .committee-card-pro {
        background: #fff;
        border: 1px solid #e9eaed;
        border-radius: 18px;
        padding: 20px 20px 24px;
        position: relative;
        transition: .25s ease;
        text-align: center;
    }

    .committee-card-pro:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,.09);
        border-color: #d6a84f;
    }

    /* Number badge — top-right */
    .committee-number {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 36px;
        height: 36px;
        background: #172033;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "DM Sans", sans-serif;
        font-size: 13px;
        font-weight: 700;
        z-index: 2;
    }

    /* Photo — fixed aspect ratio 3:4 */
    .committee-photo {
        width: 100%;
        aspect-ratio: 3 / 4;
        background: #f5f1e7;
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

    .committee-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
        display: block;
    }

    .committee-photo-placeholder {
        font-size: 60px;
        color: #d6a84f;
        opacity: .35;
    }

    /* Meta */
    .committee-meta h4 {
        font-family: "Playfair Display", serif;
        font-size: 19px;
        font-weight: 600;
        color: #172033;
        margin-bottom: 12px;
        line-height: 1.3;
        min-height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .committee-divider {
        width: 40px;
        height: 2px;
        background: #d6a84f;
        margin: 0 auto 12px;
        border-radius: 2px;
    }

    .committee-meta span {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #d6a84f;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    @@media (max-width: 575px) {
        .committee-card-pro {
            padding: 16px 16px 20px;
        }
        .committee-meta h4 {
            font-size: 17px;
        }
        .committee-number {
            width: 32px;
            height: 32px;
            font-size: 12px;
        }
    }
</style>
}