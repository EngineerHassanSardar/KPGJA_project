@model List<Entities.Entities.ActivityLogEntry>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Activity Log";
}

<div class="page-head">
    <div class="page-head-left">
        <div class="kicker">System</div>
        <h1>Activity Log</h1>
        <p>Audit trail of all actions performed in the admin panel.</p>
    </div>
</div>

@if (TempData["Success"] is string s)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @s
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="list-card">
    <div class="list-card-head">
        <div>
            <h2>
                <i class="bi bi-clock-history"></i> Recent Activity
                <span class="count-badge">@(Model?.Count ?? 0)</span>
            </h2>
            <p class="list-card-sub">Every admin action is recorded with who, what, and when.</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-clock-history"></i></div>
            <h3>No activity yet</h3>
            <p>Actions you take in the admin panel will appear here.</p>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th style="width:180px;">When</th>
                    <th style="width:220px;">Who</th>
                    <th style="width:120px;">Action</th>
                    <th style="width:200px;">Entity</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @{ int n = 0; }
                @foreach (var log in Model.OrderByDescending(l => l.Timestamp))
                {
                    n++;
                    <tr>
                        <td class="row-num">@n</td>
                        <td class="text-muted">@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td class="strong">@log.UserEmail</td>
                        <td>
                            <span class="pill @(log.Action == "Deleted" ? "inactive" : "active")">
                                @log.Action
                            </span>
                        </td>
                        <td class="text-muted">@log.EntityType #@log.EntityId</td>
                        <td class="desc-cell">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>