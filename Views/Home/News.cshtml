@{ ViewData["Title"] = "News &amp; Updates | KPGJA"; }

@section Styles {
<style>

        .news-intro {
            max-width: 820px;
            margin: 0 auto;
        }

        .news-card {
            background: #fff;
            border: 1px solid #e9eaed;
            border-radius: 20px;
            overflow: hidden;
            height: 100%;
            transition: .25s ease;
        }

        .news-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,.08);
        }

        .news-image {
            height: 230px;
            position: relative;
            overflow: hidden;
            background: #172033;
        }

        .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

        .news-card:hover .news-image img {
            transform: scale(1.06);
        }

        .news-category {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 2;
            background: #d6a84f;
            color: #172033;
            padding: 7px 13px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .news-date {
            position: absolute;
            right: 15px;
            bottom: 15px;
            z-index: 2;
            width: 62px;
            height: 65px;
            background: #fff;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

        .news-date strong {
            font-size: 20px;
            line-height: 1;
            color: #172033;
        }

        .news-date span {
            font-size: 10px;
            text-transform: uppercase;
            color: #b88a2d;
            font-weight: 700;
            margin-top: 4px;
        }

        .news-body {
            padding: 25px;
        }

        .news-body h4 {
            font-family: "Playfair Display", serif;
            color: #172033;
            margin-bottom: 10px;
            line-height: 1.35;
        }

        .news-body p {
            color: #6c7280;
            font-size: 14px;
            line-height: 1.7;
        }

        .news-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            color: #6c7280;
            font-size: 13px;
            margin-bottom: 15px;
        }

        .news-meta i {
            color: #b88a2d;
            margin-right: 5px;
        }

        .news-link {
            color: #b88a2d;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

        .news-link:hover {
            color: #172033;
        }

        .featured-news {
            background: #172033;
            border-radius: 22px;
            overflow: hidden;
            color: #fff;
        }

        .featured-news-image {
            min-height: 390px;
            height: 100%;
            position: relative;
        }

        .featured-news-image img {
            width: 100%;
            height: 100%;
            min-height: 390px;
            object-fit: cover;
        }

        .featured-news-content {
            padding: 45px;
        }

        .featured-news-content h2 {
            font-family: "Playfair Display", serif;
            font-size: 32px;
            margin-bottom: 18px;
        }

        .featured-news-content p {
            color: rgba(255,255,255,.72);
            line-height: 1.8;
        }

        .featured-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(214,168,79,.15);
            color: #d6a84f;
            border: 1px solid rgba(214,168,79,.3);
            padding: 7px 13px;
            border-radius: 50px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .featured-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            color: rgba(255,255,255,.65);
            font-size: 13px;
            margin-bottom: 25px;
        }

        .featured-meta i {
            color: #d6a84f;
            margin-right: 5px;
        }

        .news-section-title {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 25px;
        }

        .news-section-title h2 {
            margin-bottom: 0;
        }

        .news-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .news-filter .btn {
            border-radius: 50px;
            font-size: 13px;
            padding: 8px 15px;
        }

        .news-info {
            background: #f7f5ef;
            border-radius: 22px;
            padding: 45px;
        }

        .news-info-icon {
            width: 58px;
            height: 58px;
            border-radius: 15px;
            background: #fff;
            color: #b88a2d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 5px 18px rgba(0,0,0,.05);
        }

        .news-info h3 {
            font-family: "Playfair Display", serif;
            color: #172033;
        }

        .news-info p {
            color: #6c7280;
        }

        .news-cta {
            background: #172033;
            border-radius: 22px;
            padding: 45px;
            color: #fff;
        }

        .news-cta h2 {
            font-family: "Playfair Display", serif;
        }

        .news-cta p {
            color: rgba(255,255,255,.7);
            max-width: 700px;
        }

        @@media (max-width: 767px) {
            .featured-news-content {
                padding: 30px;
            }

            .featured-news-content h2 {
                font-size: 27px;
            }

            .featured-news-image,
            .featured-news-image img {
                min-height: 260px;
            }

            .news-info,
            .news-cta {
                padding: 30px;
            }

            .news-section-title {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    
</style>
}

<!-- TOP BAR -->


<!-- HERO -->
<section class="page-hero">
    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="section-kicker text-warning">
                    KPGJA NEWS
                </span>

                <h1>
                    News & Updates
                </h1>

                <p class="lead text-white-50 mt-3">
                    Stay informed about KPGJA announcements,
                    industry developments, programs, opportunities
                    and association activities.
                </p>

            </div>

        </div>

    </div>
</section>

<main>

    <!-- INTRO -->
    <section class="py-5">

        <div class="container">

            <div class="news-intro text-center">

                <span class="section-kicker">
                    STAY INFORMED
                </span>

                <h2 class="section-heading">
                    Latest from the KPGJA community
                </h2>

                <p class="section-description">
                    Follow important association announcements,
                    industry initiatives, training opportunities,
                    networking activities and developments
                    affecting the gems and jewellery sector.
                </p>

            </div>

        </div>

    </section>


    <!-- FEATURED NEWS -->
    <section class="pb-5">

        <div class="container">

            <div class="featured-news">

                <div class="row g-0 align-items-stretch">

                    <div class="col-lg-6">

                        <div class="featured-news-image">

                            <img src="/assets/img/news/featured-news.jpg"
                                 alt="KPGJA News and Industry Updates"
                                 loading="lazy">

                        </div>

                    </div>

                    <div class="col-lg-6">

                        <div class="featured-news-content">

                            <div class="featured-label">
                                <i class="bi bi-star-fill"></i>
                                Featured Update
                            </div>

                            <h2>
                                Strengthening the Gems & Jewellery Industry
                            </h2>

                            <div class="featured-meta">

                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    Latest Update
                                </span>

                                <span>
                                    <i class="bi bi-building"></i>
                                    KPGJA
                                </span>

                            </div>

                            <p>
                                KPGJA continues to work toward stronger
                                industry collaboration, skills development,
                                business networking, market opportunities
                                and greater representation for stakeholders
                                across Khyber Pakhtunkhwa.
                            </p>

                            <a href="#latest-news"
                               class="btn btn-gold">
                                Explore Updates
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LATEST NEWS -->
    <section class="py-5" id="latest-news">

        <div class="container">

            <div class="news-section-title">

                <div>
                    <span class="section-kicker">
                        LATEST
                    </span>

                    <h2 class="section-heading">
                        News & Announcements
                    </h2>
                </div>

                <div class="news-filter">

                    <button type="button"
                            class="btn btn-outline-secondary">
                        All
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary">
                        Announcements
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary">
                        Industry
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary">
                        Programs
                    </button>

                </div>

            </div>


            <div class="row g-4">

                <!-- NEWS 1 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/training.jpg"
                                 alt="Training Program"
                                 loading="lazy">

                            <span class="news-category">
                                Programs
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-megaphone"></i>
                                    Announcement
                                </span>

                            </div>

                            <h4>
                                KPGJA Training & Skills Development Program
                            </h4>

                            <p>
                                Information about upcoming training,
                                capacity-building initiatives and
                                opportunities for members and industry
                                stakeholders.
                            </p>

                            <a href="#"
                               class="news-link">
                                Read More
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>


                <!-- NEWS 2 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/networking.jpg"
                                 alt="Industry Networking Meeting"
                                 loading="lazy">

                            <span class="news-category">
                                Industry
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-people"></i>
                                    Networking
                                </span>

                            </div>

                            <h4>
                                Industry Stakeholder Networking
                            </h4>

                            <p>
                                Updates about meetings, consultations
                                and networking activities connecting
                                businesses, professionals and stakeholders.
                            </p>

                            <a href="#"
                               class="news-link">
                                Read More
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>


                <!-- NEWS 3 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/jewellery.jpg"
                                 alt="Jewellery Industry Opportunities"
                                 loading="lazy">

                            <span class="news-category">
                                Industry
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-gem"></i>
                                    Market
                                </span>

                            </div>

                            <h4>
                                Opportunities for Local Jewellery
                            </h4>

                            <p>
                                Updates about market opportunities,
                                exhibitions, trade activities and
                                initiatives supporting local businesses.
                            </p>

                            <a href="#"
                               class="news-link">
                                Read More
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>


                <!-- NEWS 4 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/membership.jpg"
                                 alt="KPGJA Membership"
                                 loading="lazy">

                            <span class="news-category">
                                Membership
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-person-plus"></i>
                                    Members
                                </span>

                            </div>

                            <h4>
                                KPGJA Membership Updates
                            </h4>

                            <p>
                                Membership announcements, registration
                                information, member services and important
                                updates for the KPGJA community.
                            </p>

                            <a href="#"
                               class="news-link">
                                Read More
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>


                <!-- NEWS 5 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/exhibition.jpg"
                                 alt="Gems and Jewellery Exhibition"
                                 loading="lazy">

                            <span class="news-category">
                                Events
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-calendar-event"></i>
                                    Events
                                </span>

                            </div>

                            <h4>
                                Gems & Jewellery Exhibitions
                            </h4>

                            <p>
                                Announcements and information about
                                exhibitions, trade shows and activities
                                bringing the industry together.
                            </p>

                            <a href="/Home/Events"
                               class="news-link">
                                View Events
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>


                <!-- NEWS 6 -->
                <div class="col-md-6 col-lg-4">

                    <article class="news-card">

                        <div class="news-image">

                            <img src="/assets/img/news/women.jpg"
                                 alt="Women Empowerment"
                                 loading="lazy">

                            <span class="news-category">
                                Women
                            </span>

                            <div class="news-date">
                                <strong>--</strong>
                                <span>Date</span>
                            </div>

                        </div>

                        <div class="news-body">

                            <div class="news-meta">

                                <span>
                                    <i class="bi bi-person-hearts"></i>
                                    Empowerment
                                </span>

                            </div>

                            <h4>
                                Women Entrepreneurship & Skills
                            </h4>

                            <p>
                                Updates about initiatives supporting women
                                entrepreneurs, skills development and
                                participation in the gems and jewellery sector.
                            </p>

                            <a href="/Home/Women"
                               class="news-link">
                                Explore
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>

                        </div>

                    </article>

                </div>

            </div>

        </div>

    </section>


    <!-- INFORMATION SECTION -->
    <section class="py-5">

        <div class="container">

            <div class="news-info">

                <div class="row align-items-center g-4">

                    <div class="col-auto">

                        <div class="news-info-icon">
                            <i class="bi bi-bell"></i>
                        </div>

                    </div>

                    <div class="col">

                        <h3>
                            Stay connected with KPGJA
                        </h3>

                        <p class="mb-0">
                            Members can stay informed about association
                            announcements, events, programs, opportunities
                            and other important updates through the KPGJA
                            member portal.
                        </p>

                    </div>

                    <div class="col-lg-auto">

                        <a href="/Member/Login"
                           class="btn btn-navy">
                            Member Login
                            <i class="bi bi-box-arrow-in-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="py-5">

        <div class="container">

            <div class="news-cta text-center">

                <span class="section-kicker text-warning">
                    JOIN THE COMMUNITY
                </span>

                <h2 class="mt-2">
                    Be part of the KPGJA network
                </h2>

                <p class="mx-auto mt-3 mb-4">
                    Become a member and stay connected with industry
                    activities, networking opportunities, programs,
                    events and association updates.
                </p>

                <div class="d-flex justify-content-center flex-wrap gap-3">

                    <a href="/Member/Register"
                       class="btn btn-gold btn-lg">
                        <i class="bi bi-person-plus me-1"></i>
                        Become a Member
                    </a>

                    <a href="/Home/Contact"
                       class="btn btn-outline-light btn-lg">
                        Contact KPGJA
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                </div>

            </div>

        </div>

    </section>

</main>


