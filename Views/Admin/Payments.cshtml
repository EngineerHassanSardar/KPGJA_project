@model List<Entities.Entities.MembershipApplication>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Payments";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <p class="text-secondary mb-0">Manage all membership applications.</p>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-dark btn-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <button class="btn btn-outline-dark btn-sm" onclick="alert('Export to Excel (UI only)')">
            <i class="bi bi-file-earmark-excel me-1"></i> Export
        </button>
    </div>
</div>
<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon gold"><i class="bi bi-receipt"></i></div>
            <div class="stat-label">Total Expected</div>
            <div class="stat-value">@(Model?.Sum(m => m.MembershipFee) ?? 0)</div>
            <div class="stat-trend"><i class="bi bi-dash"></i> Awaiting collection</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon success"><i class="bi bi-cash-coin"></i></div>
            <div class="stat-label">Collected</div>
            <div class="stat-value">@(Model?.Sum(m => m.FeeReceived) ?? 0)</div>
            <div class="stat-trend up"><i class="bi bi-arrow-up-short"></i> On track</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-exclamation-triangle"></i></div>
            <div class="stat-label">Outstanding</div>
            <div class="stat-value">@((Model?.Sum(m => m.MembershipFee) - Model?.Sum(m => m.FeeReceived)) ?? 0)</div>
            <div class="stat-trend down"><i class="bi bi-arrow-down-short"></i> Follow up</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-people"></i></div>
            <div class="stat-label">Pending Payments</div>
            <div class="stat-value">@(Model?.Count ?? 0)</div>
            <div class="stat-trend"><i class="bi bi-dash"></i> In pipeline</div>
        </div>
    </div>
</div>

<!-- Payments Table -->
<div class="admin-table-card">
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Business</th>
                    <th>Amount</th>
                    <th>Reference</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i> No payments in pipeline.
                    </td></tr>
                }
                else
                {
                    @foreach (var m in Model)
                    {
                        var statusClass = m.Status switch
                        {
                            "Approved for Payment" => "status-approved-pay",
                            "Payment Submitted"    => "status-payment-sub",
                            "Payment Verified"     => "status-payment-ver",
                            _ => "status-pending"
                        };
                        <tr>
                            <td>
                                <div class="member-name">@m.FullName</div>
                                <div class="member-sub">@m.Email</div>
                            </td>
                            <td>@m.BusinessName</td>
                            <td class="fw-semibold">PKR @m.MembershipFee.ToString("N0")</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(m.PaymentReference) ? "—" : m.PaymentReference)</td>
                            <td><span class="status-badge @statusClass">@m.Status</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-dark" style="border-radius:8px;" href="/Admin/Details/@m.Id">
                                    Verify <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>