@model Entities.Entities.ContactInquiry
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Inquiry Details"; }

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <a href="/Admin/Contact" class="text-muted small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Inquiries
        </a>
        <h2 class="page-title mb-0 mt-1" style="font-size:18px;">@Model.Subject</h2>
    </div>
    <div class="d-flex gap-2">
        <span class="status-badge @(Model.IsReplied ? "status-active" : Model.IsRead ? "status-approved-pay" : "status-pending")">
            @(Model.IsReplied ? "Replied" : Model.IsRead ? "Read" : "Unread")
        </span>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-1"></i> @success
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="soft-card p-4 mb-3">
            <h5 class="card-head-title small fw-bold mb-3">
                <i class="bi bi-chat-left-text me-1"></i> Message
            </h5>
            <p style="font-size:12px;line-height:1.7;color:#333;">@Model.Message</p>
        </div>

        <div class="soft-card p-4">
            <h5 class="card-head-title small fw-bold mb-3">
                <i class="bi bi-reply me-1"></i> Reply
            </h5>
            <textarea class="form-control mb-3" rows="5" placeholder="Write your reply..."></textarea>
            <div class="d-flex justify-content-end">
                <button class="btn btn-gold btn-sm" onclick="alert('Send reply (preview only)')">
                    <i class="bi bi-send me-1"></i> Send Reply
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="soft-card p-4">
            <h5 class="card-head-title small fw-bold mb-3">
                <i class="bi bi-person me-1"></i> Sender
            </h5>
            <div class="small">
                <div class="mb-2"><div class="text-muted">Name</div><div class="fw-semibold">@Model.FullName</div></div>
                <div class="mb-2"><div class="text-muted">Email</div><div class="fw-semibold">@Model.Email</div></div>
                <div class="mb-2"><div class="text-muted">Phone</div><div class="fw-semibold">@Model.Phone</div></div>
                <div class="mb-2"><div class="text-muted">Received</div><div class="fw-semibold">@Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div></div>
            </div>\\
        </div>
    </div>
</div>