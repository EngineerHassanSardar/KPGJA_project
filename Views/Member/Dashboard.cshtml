<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="section-kicker">MEMBER PORTAL</span>
            <h2 class="section-heading mb-1">Welcome, @User.Identity?.Name</h2>
            <p class="text-secondary mb-0">Track your KPGJA membership application from your portal.</p>
        </div>
        <form asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-dark"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
        </form>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (app == null)
    {
        <div class="alert alert-info">No membership application is linked to this account.</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="soft-card p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <div class="small text-uppercase text-muted">Application</div>
                            <h4 class="mb-1">@app.BusinessName</h4>
                            <div class="text-secondary">@app.MembershipCategory</div>
                        </div>
                        <span class="badge bg-dark px-3 py-2">@app.Status</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6"><div class="small text-muted">Applicant</div><strong>@app.FullName</strong></div>
                        <div class="col-md-6"><div class="small text-muted">Application Date</div><strong>@app.ApplicationDate.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                        <div class="col-md-6"><div class="small text-muted">Membership Fee</div><strong>PKR @app.MembershipFee.ToString("N0")</strong></div>
                        <div class="col-md-6"><div class="small text-muted">Membership No.</div><strong>@(app.MembershipNo ?? "Assigned after approval")</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(app.AdminRemarks))
                    {
                        <div class="alert alert-light border mt-4 mb-0"><strong>Admin Remarks:</strong><br>@app.AdminRemarks</div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="soft-card p-4 h-100">
                    <h5>Application Process</h5>
                    <div class="d-flex gap-3 mt-4"><i class="bi bi-check-circle-fill text-success"></i><div><strong>Application Submitted</strong><div class="small text-muted">Received by KPGJA</div></div></div>
                    <div class="d-flex gap-3 mt-4"><i class="bi bi-clock-history text-warning"></i><div><strong>Administrative Review</strong><div class="small text-muted">Current status: @app.Status</div></div></div>
                    <div class="d-flex gap-3 mt-4"><i class="bi bi-person-check text-secondary"></i><div><strong>Final Approval</strong><div class="small text-muted">Membership number is assigned by KPGJA admin.</div></div></div>
                </div>
            </div>
        </div>
    }
</div>