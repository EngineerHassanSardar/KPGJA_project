<!-- ========== 4. MEMBERSHIP CTA (single-editor) ========== -->
@if (showCtaForm)
{
    <form method="post" asp-action="HomeCtaSave">
        @Html.AntiForgeryToken()

        <div class="list-card mb-3" style="border:2px solid var(--kpgja-gold);">
            <div class="list-card-head">
                <div>
                    <h2><i class="bi bi-pencil-square"></i> Edit Membership CTA Banner</h2>
                    <p class="list-card-sub">The join-membership banner shown on the homepage.</p>
                </div>
                <a href="/Admin/HomeContent" class="btn-cancel">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Heading</label>
                        <input name="Heading" class="form-control" value="Become a Member Today">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Button Text</label>
                        <input name="CtaText" class="form-control" value="Apply Now">
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Body</label>
                        <textarea name="Body" class="form-control" rows="3">Join KP's leading network of gem and jewellery professionals.</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Button Link</label>
                        <input name="CtaLink" class="form-control" value="/Member/Register">
                    </div>
                </div>
            </div>
            <div class="p-4 pt-0 d-flex justify-content-end gap-2">
                <a href="/Admin/HomeContent" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-add">
                    <i class="bi bi-check2"></i> Save CTA Banner
                </button>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        // Scroll to form if any is open
        @if (showSlideForm || showObjectiveForm || showQuickLinkForm || showCtaForm)
        {
            <text>
                const form = document.querySelector('.list-card[style*="var(--kpgja-gold)"]');
                if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            </text>
        }
    </script>
}